---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ResourceArticle from '../../../components/page-content/ResourceArticle.astro';
import { resourcePages } from '../../../content/resources.mjs';
const path = '/resources/punchout-implementation-guide/';
const content = resourcePages[path];
---
<SiteLayout title="PunchOut Implementation Guide for Suppliers | PunchOut Central" description="Follow a practical PunchOut implementation plan: define the buyer connection, connect Shopify, assign catalog access, test the PO handoff and launch." ogType="article" includeSiteScript={true} bodyClass="inner-page">
  <ResourceArticle path={path} {...content} />
</SiteLayout>
