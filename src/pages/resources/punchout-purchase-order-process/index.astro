---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ResourceArticle from '../../../components/page-content/ResourceArticle.astro';
import { resourcePages } from '../../../content/resources.mjs';
const path = '/resources/punchout-purchase-order-process/';
const content = resourcePages[path];
---
<SiteLayout title="PunchOut Purchase Order Process Explained | PunchOut Central" description="Learn why a returned PunchOut cart is not yet a purchase order, how buyer approval works and when the approved PO creates a Shopify order." ogType="article" includeSiteScript={true} bodyClass="inner-page">
