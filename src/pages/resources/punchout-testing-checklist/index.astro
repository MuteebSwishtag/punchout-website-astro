---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ResourceArticle from '../../../components/page-content/ResourceArticle.astro';
import { resourcePages } from '../../../content/resources.mjs';
const path = '/resources/punchout-testing-checklist/';
const content = resourcePages[path];
---
<SiteLayout title="PunchOut Testing Checklist: Catalog to PO | PunchOut Central" description="Use a practical PunchOut testing checklist for session launch, catalog access, cart return, buyer approval, PO receipt, Shopify order creation and invoice review." ogType="article" includeSiteScript={true} bodyClass="inner-page">
  <ResourceArticle path={path} {...content} />
</SiteLayout>
