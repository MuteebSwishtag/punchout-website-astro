---
import { resourcePages } from '../../../content/resources.mjs';
const resourceLinks = Object.entries(resourcePages);
---
<main>

<section class="page-hero page-hero--mint" id="overview">
  <div class="wrap page-hero__grid">
    <div class="page-hero__copy reveal">
      <span class="ey">Resources</span>
      <h1>Understand PunchOut without reading an enterprise software manual.</h1>
      <p class="lead">Use simple guides, platform documentation and practical explanations for suppliers, ecommerce teams and procurement projects.</p>
      <div class="page-hero__actions">
        <a class="btn pri" href="/resources/punchout-guide/">Read the PunchOut guide <span aria-hidden="true">→</span></a>
        <a class="btn secbtn" href="#details">Browse resources <span aria-hidden="true">↓</span></a>
      </div>
      <div class="page-proofline">
        <span><b>✓</b> No setup fee</span>
        <span><b>✓</b> Free onboarding assistance</span>
        <span><b>✓</b> No transaction fees</span>
      </div>
    </div>
    
    <div class="hero-visual reveal">
      <div class="hero-visual__label"><span>PunchOut Central</span><b>Connected</b></div>
      <div class="visual-flow"><div class="visual-step is-accent"><i>01</i><span><strong>PunchOut Guide</strong><small>Start with the basics</small></span><em>Guide</em></div><div class="visual-step is-lavender"><i>02</i><span><strong>Documentation</strong><small>Product and integration notes</small></span><em>Docs</em></div><div class="visual-step is-peach"><i>03</i><span><strong>FAQ</strong><small>Common supplier questions</small></span><em>Answers</em></div><div class="visual-step is-lime"><i>04</i><span><strong>Insights</strong><small>Practical procurement content</small></span><em>Articles</em></div></div>
    </div>
  </div>
</section>




<section class="sec" id="details"><div class="wrap"><div class="section-head reveal"><span class="ey">Resource library</span><h2>Start wherever your question starts.</h2></div>
<div class="resource-list">
<a class="resource-card reveal" href="/resources/punchout-guide/"><span>Guide</span><h3>What is PunchOut?</h3><p>A supplier-friendly introduction to PunchOut, cart return, procurement approval and POs.</p><b>Read guide →</b></a>
<a class="resource-card reveal" href="/documentation/"><span>Documentation</span><h3>PunchOut Central Docs</h3><p>Explore buyer connections, purchase orders, transactions and integrations.</p><b>Open docs →</b></a>
<a class="resource-card reveal" href="/faq/"><span>FAQ</span><h3>Supplier Questions</h3><p>Simple answers to the questions that usually come up before a PunchOut project starts.</p><b>Read FAQ →</b></a>
<a class="resource-card reveal" href="/insights/"><span>Insights</span><h3>Procurement + Commerce Insights</h3><p>Follow the PunchOut journey through Shopify, protocols and purchase orders.</p><b>Browse insights →</b></a>
</div></div></section>
<section class="sec soft" id="technical-guides"><div class="wrap"><div class="section-head reveal"><span class="ey">Technical guides</span><h2>Go deeper on the question in front of you.</h2><p class="lead">These guides explain protocols, catalog models, implementation steps and the purchase-order journey without replacing the buyer's own technical requirements.</p></div>
<div class="resource-list">
{resourceLinks.map(([path, page]) => <a class="resource-card reveal" href={path}><span>{page.eyebrow}</span><h3>{page.title}</h3><p>{page.lead}</p><b>Read the guide &rarr;</b></a>)}
</div></div></section>
<section class="page-cta">
  <div class="wrap reveal">
    <span class="ey">A bigger opportunity is waiting</span>
    <h2>Still have a buyer requirement in front of you?</h2>
    <p class="lead">Show us what the customer asked for and we will help you understand the path.</p>
    <div class="page-hero__actions">
      <a class="btn pri" href="https://app.punchoutcentral.com/platform/register" target="_blank">Connect my first buyer →</a>
      <a class="btn secbtn" href="/pricing/">See pricing</a>
    </div>
  </div>
</section>
</main>
