---
import { faqItems } from '../../../content/faq.mjs';
---
<main>
  <section class="page-hero page-hero--mint" id="overview"><div class="wrap page-hero__grid">
    <div class="page-hero__copy reveal"><span class="ey">PunchOut FAQ</span><h1>Answers about Shopify PunchOut, buyer connections and pricing.</h1><p class="lead">See when a buyer cart becomes an order, how catalog access works, what the plans include and where to get support.</p><div class="page-hero__actions"><a class="btn pri" href="#faq">Read the answers &darr;</a><a class="btn secbtn" href="/book-demo/">Discuss your buyer</a></div></div>
    <div class="hero-visual reveal"><div class="hero-visual__label"><span>Common questions</span><b>Clear answers</b></div><div class="visual-flow"><div class="visual-step is-accent"><i>01</i><span><strong>Commerce</strong><small>Keep your Shopify store</small></span></div><div class="visual-step is-lavender"><i>02</i><span><strong>Procurement</strong><small>cXML and OCI workflows</small></span></div><div class="visual-step is-peach"><i>03</i><span><strong>Pricing</strong><small>Connections, not transactions</small></span></div></div></div>
  </div></section>
  <section class="sec soft" id="faq"><div class="wrap"><div class="section-head reveal"><span class="ey">Questions and answers</span><h2>Plan the full buyer workflow.</h2><p class="lead">Requirements can differ by procurement environment. Use these answers as a starting point, then validate your buyer-specific flow.</p></div><div class="faq reveal">
    {faqItems.map(([question, answer]) => <div class="fi"><button class="fq" type="button"><span>{question}</span><span class="plus">+</span></button><div class="fa"><p>{answer}</p></div></div>)}
  </div></div></section>
  <section class="sec"><div class="wrap"><div class="section-head reveal"><span class="ey">Go deeper</span><h2>Follow the answer to the right page.</h2></div><div class="related-grid">
    <a class="related-card reveal" href="/how-it-works/"><span>Workflow</span><h3>How PunchOut works</h3><p>Follow the six stages from buyer session to invoice.</p><b>Explore &rarr;</b></a>
    <a class="related-card reveal" href="/integrations/procurement-systems/"><span>Buyer systems</span><h3>Procurement integrations</h3><p>Review cXML, OCI and buyer platform requirements.</p><b>Explore &rarr;</b></a>
    <a class="related-card reveal" href="/pricing/"><span>Plans</span><h3>Connection pricing</h3><p>Compare Starter, Growth, Scale and additional connections.</p><b>Explore &rarr;</b></a>
    <a class="related-card reveal" href="/documentation/"><span>Setup</span><h3>Documentation</h3><p>Prepare the store, buyer details and test sequence.</p><b>Explore &rarr;</b></a>
  </div></div></section>
  <section class="page-cta"><div class="wrap reveal"><span class="ey">Your buyer requirement</span><h2>Ask about the details of your connection.</h2><p class="lead">Share the procurement system, Shopify store and catalog scope for a focused conversation.</p><div class="page-hero__actions"><a class="btn pri" href="/book-demo/">Request a demo &rarr;</a><a class="btn secbtn" href="/contact/">Contact the team</a></div></div></section>
</main>
