<main>

<!--
  Standalone PunchOut platform section.
  Paste this full block wherever you want the section to appear.
  Asset paths assume the file is used inside this project/site where public/assets is served as /assets.
-->
<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap");

  .pc-standalone,
  .pc-standalone * {
    box-sizing: border-box;
  }

  .pc-standalone {
    --pc-ink: #222629;
    --pc-muted: #647075;
    --pc-mint: #a8feef;
    --pc-line: #e4e9e9;
    --pc-max: 1350px;
    overflow: hidden;
    padding: 74px 0 86px;
    background:
      radial-gradient(ellipse 540px 400px at 93% 30%, #f2f0ff 0, transparent 80%),
      radial-gradient(ellipse 540px 420px at 73% 78%, #e8fff9 0, transparent 79%),
      radial-gradient(ellipse 500px 320px at 5% 100%, #fff5ef 0, transparent 80%),
      #fff;
    color: var(--pc-ink);
    font-family: "Plus Jakarta Sans", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .pc-standalone a {
    color: inherit;
    text-decoration: none;
  }

  .pc-standalone a:focus-visible {
    outline: 3px solid #247e75;
    outline-offset: 3px;
  }

  .pc-standalone__wrap {
    width: min(calc(100% - 64px), var(--pc-max));
    margin: auto;
  }

  .pc-standalone__grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(30px, 3vw, 48px);
    align-items: center;
  }

  .pc-standalone__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #59646a;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .095em;
    text-transform: uppercase;
  }

  .pc-standalone__eyebrow::before {
    content: "";
    width: 22px;
    height: 2px;
    background: #b9ef36;
  }

  .pc-standalone h1 {
    max-width: 565px;
    margin: 21px 0;
    font-size: clamp(51px, 5.3vw, 78px);
    line-height: 1.03;
    font-weight: 800;
    letter-spacing: -.065em;
  }

  .pc-standalone p {
    max-width: 505px;
    margin: 0;
    color: var(--pc-muted);
    font-size: 16px;
    line-height: 1.72;
  }

  .pc-standalone__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }

  .pc-standalone__btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 11px 19px;
    border: 1px solid transparent;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 800;
    transition: transform .2s, box-shadow .2s, background .2s;
  }

  .pc-standalone__btn:hover {
    transform: translateY(-2px);
  }

  .pc-standalone__btn--mint {
    background: var(--pc-mint);
  }

  .pc-standalone__btn--mint:hover {
    box-shadow: 0 7px 18px #6fd8cb60;
  }

  .pc-standalone__btn--outline {
    border-color: #dbe0e2;
    background: #fff;
  }

  .pc-standalone__btn--outline:hover {
    background: #f0faf8;
  }

  .pc-standalone__integration {
    container-type: inline-size;
    width: 100%;
    min-width: 0;
    isolation: isolate;
  }

  .pc-open-labels,
  .pc-open-system-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 216px minmax(0, 1fr);
    column-gap: clamp(24px, 5cqw, 40px);
    align-items: center;
  }

  .pc-open-labels {
    margin-bottom: 12px;
    color: #617076;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .065em;
    text-align: center;
  }

  .pc-open-system-flow {
    position: relative;
    min-height: 330px;
    isolation: isolate;
  }

  .pc-open-connectors {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .pc-open-connectors path {
    animation: pc-connector-flow 2.8s linear infinite;
  }

  .pc-open-connectors path:nth-of-type(2) { animation-delay: -.45s; }
  .pc-open-connectors path:nth-of-type(3) { animation-delay: -.9s; }
  .pc-open-connectors path:nth-of-type(4) { animation-delay: -1.35s; }

  .pc-open-procurement,
  .pc-open-hub,
  .pc-open-commerce {
    position: relative;
    z-index: 1;
  }

  .pc-open-procurement,
  .pc-open-commerce {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .pc-open-system {
    height: 62px;
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 11px 15px;
    border: 1px solid #e1e8e8;
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 7px 20px #223c3909;
    transition: transform .22s, border-color .22s, box-shadow .22s;
  }

  .pc-open-system:hover {
    transform: translateY(-4px);
    border-color: #92e6d6;
    box-shadow: 0 13px 25px #24685a14;
  }

  .pc-open-system img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 120px;
    object-fit: contain;
  }

  .pc-open-hub {
    width: 216px;
    height: 216px;
    min-height: 0;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: auto;
    padding: 23px 18px;
    border: 1px solid #52d7c6;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 14px rgba(111, 233, 213, .13), 0 18px 40px rgba(27, 85, 74, .09);
    text-align: center;
  }

  .pc-open-hub-small {
    color: #6a7a79;
    font-size: 9px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: .08em;
  }

  .pc-open-brand-logo {
    display: block;
    width: 145px;
    max-width: 100%;
    height: 73px;
    object-fit: contain;
    margin: 1px auto 0;
  }

  .pc-open-hub-desc {
    margin-top: 1px;
    color: #617574;
    font-size: 10px;
    line-height: 1.45;
  }

  .pc-open-connected {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    padding: 6px 10px;
    border-radius: 100px;
    background: #d1fff4;
    color: #197968;
    font-size: 9px;
    font-weight: 800;
  }

  .pc-open-connected i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #28b99c;
  }

  .pc-open-commerce .pc-open-system {
    height: 84px;
  }

  .pc-open-commerce img {
    max-width: 72px;
  }

  .pc-open-legend {
    margin-top: 16px;
    padding-top: 15px;
    border-top: 1px solid #e8eeee;
    color: #627475;
    font-size: 10px;
    line-height: 1.7;
    text-align: center;
  }

  .pc-open-legend span {
    margin: 0 5px;
    color: #23b79c;
  }

  @keyframes pc-connector-flow {
    to { stroke-dashoffset: -24; }
  }

  @media (max-width: 1150px) {
    .pc-standalone__grid {
      grid-template-columns: 1fr;
      gap: 46px;
    }

    .pc-standalone__copy {
      max-width: 720px;
    }

    .pc-standalone h1 {
      max-width: 720px;
      font-size: clamp(48px, 7vw, 74px);
    }

    .pc-standalone__integration {
      max-width: 720px;
      margin-inline: auto;
    }
  }

  @media (max-width: 600px) {
    .pc-standalone {
      padding: 42px 0 48px;
    }

    .pc-standalone__wrap {
      width: calc(100% - 36px);
    }

    .pc-standalone__grid {
      gap: 30px;
    }

    .pc-standalone h1 {
      margin: 18px 0;
      font-size: clamp(39px, 10.5vw, 58px);
      line-height: 1.07;
    }

    .pc-standalone p {
      font-size: 14px;
      line-height: 1.7;
    }

    .pc-standalone__actions {
      gap: 10px;
      margin-top: 22px;
    }

    .pc-standalone__btn {
      min-height: 46px;
      padding: 12px 16px;
    }
  }

  @media (max-width: 360px) {
    .pc-standalone__btn {
      width: 100%;
    }

    .pc-standalone__wrap {
      width: calc(100% - 28px);
    }
  }

  @container (max-width: 560px) {
    .pc-open-labels {
      display: none;
    }

    .pc-open-system-flow {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
      min-height: 0;
    }

    .pc-open-procurement,
    .pc-open-commerce {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 7px;
    }

    .pc-open-procurement::before {
      content: "BUYER PROCUREMENT";
    }

    .pc-open-commerce::after {
      content: "YOUR COMMERCE";
    }

    .pc-open-procurement::before,
    .pc-open-commerce::after {
      grid-column: 1 / -1;
      display: block;
      margin: 0 0 5px;
      color: #67787a;
      font-size: 9px;
      font-weight: 800;
      line-height: 1.5;
      letter-spacing: .07em;
      text-align: center;
    }

    .pc-open-system-flow .pc-open-system {
      width: 100%;
      max-width: none;
      height: 58px;
      margin: 0;
      padding: 8px 7px;
      border-radius: 12px;
    }

    .pc-open-system-flow .pc-open-system img {
      width: 100%;
      height: 100%;
      max-width: 120px;
    }

    .pc-open-hub {
      width: 158px;
      height: 158px;
      flex: none;
      padding: 18px 12px;
      box-shadow: 0 0 0 8px rgba(111, 233, 213, .13), 0 12px 26px rgba(27, 85, 74, .07);
    }

    .pc-open-hub-small {
      font-size: 7px;
      letter-spacing: .06em;
    }

    .pc-open-brand-logo {
      width: 108px;
      height: 53px;
      margin: 3px auto 0;
    }

    .pc-open-hub-desc {
      display: none;
    }

    .pc-open-connected {
      margin-top: 7px;
      padding: 5px 9px;
      font-size: 8px;
      line-height: 1.4;
    }

    .pc-open-connected i {
      width: 5px;
      height: 5px;
    }

    .pc-open-legend {
      margin-top: 18px;
      padding-top: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-standalone *,
    .pc-standalone *::before,
    .pc-standalone *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<section class="pc-standalone" id="punchout-platform-overview">
  <div class="pc-standalone__wrap pc-standalone__grid">
    <div class="pc-standalone__copy">
      <span class="pc-standalone__eyebrow">Platform overview</span>
      <h1>One platform between procurement and commerce.</h1>
      <p>Manage buyer connections, PunchOut sessions, carts, purchase orders, store orders and invoices from one place.</p>
      <div class="pc-standalone__actions">
        <a class="pc-standalone__btn pc-standalone__btn--mint" href="https://app.punchoutcentral.com/register">Connect my first buyer <span aria-hidden="true">&rarr;</span></a>
        <a class="pc-standalone__btn pc-standalone__btn--outline" href="https://punchoutcentral.com/platform/#modules">Explore the platform <span aria-hidden="true">&darr;</span></a>
      </div>
    </div>

    <div class="pc-standalone__integration" role="group" aria-label="Procurement systems connect through PunchOut Central to Shopify, Magento and BigCommerce">
      <div class="pc-open-labels" aria-hidden="true">
        <span>BUYER PROCUREMENT</span>
        <span>ONE CONNECTION LAYER</span>
        <span>YOUR COMMERCE</span>
      </div>

      <div class="pc-open-system-flow">
        <svg class="pc-open-connectors" aria-hidden="true" focusable="false"></svg>

        <div class="pc-open-procurement">
          <div class="pc-open-system"><img src="/assets/logos/coupa.svg" alt="Coupa"></div>
          <div class="pc-open-system"><img src="/assets/logos/sap-ariba.png" alt="SAP Ariba"></div>
          <div class="pc-open-system"><img src="/assets/logos/oracle.svg" alt="Oracle"></div>
        </div>

        <div class="pc-open-hub">
          <span class="pc-open-hub-small">MANAGED CONNECTION</span>
          <img class="pc-open-brand-logo" src="/assets/punchout-logo-black.png" alt="PunchOut Central">
          <span class="pc-open-hub-desc">PunchOut / purchase orders / invoices</span>
          <span class="pc-open-connected"><i aria-hidden="true"></i> Connected</span>
        </div>

        <div class="pc-open-commerce">
          <div class="pc-open-system"><img src="/assets/logos/shopify.svg" alt="Shopify"></div>
          <div class="pc-open-system"><img src="/assets/logos/magento.svg" alt="Magento"></div>
          <div class="pc-open-system"><img src="/assets/logos/bigcommerce.svg" alt="BigCommerce"></div>
        </div>
      </div>

      <div class="pc-open-legend" aria-hidden="true">Multiple buyer systems <span>&rarr;</span> one managed connection <span>&rarr;</span> your existing commerce platform</div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initPunchoutStandalone(root) {
      const stage = root.querySelector(".pc-open-system-flow");
      const svg = root.querySelector(".pc-open-connectors");
      const hub = root.querySelector(".pc-open-hub");
      if (!stage || !svg || !hub) return;

      const ns = "http://www.w3.org/2000/svg";

      function draw() {
        const box = stage.getBoundingClientRect();
        if (box.width < 1 || box.height < 1) {
          svg.replaceChildren();
          return;
        }

        const vertical = getComputedStyle(stage).display === "flex";
        svg.setAttribute("viewBox", "0 0 " + box.width + " " + box.height);

        const h = hub.getBoundingClientRect();
        const cx = h.left - box.left + h.width / 2;
        const cy = h.top - box.top + h.height / 2;
        const r = h.width / 2;
        const routes = [];

        stage.querySelectorAll(".pc-open-procurement .pc-open-system").forEach(function (card) {
          const b = card.getBoundingClientRect();
          const index = routes.length;
          const dy = (index - 1) * r * .48;
          const y2 = cy + dy;
          const x1 = b.right - box.left;
          const y1 = b.top - box.top + b.height / 2;
          const x2 = cx - Math.sqrt(Math.max(0, r * r - dy * dy));

          if (vertical) {
            const dx = (index - 1) * r * .48;
            routes.push([
              b.left - box.left + b.width / 2,
              b.bottom - box.top,
              cx + dx,
              cy - Math.sqrt(Math.max(0, r * r - dx * dx))
            ]);
          } else {
            routes.push([x1, y1, x2, y2]);
          }
        });

        stage.querySelectorAll(".pc-open-commerce .pc-open-system").forEach(function (card, index) {
          const b = card.getBoundingClientRect();
          const dy = (index - 1) * r * .48;
          const x1 = cx + Math.sqrt(Math.max(0, r * r - dy * dy));
          const y1 = cy + dy;

          if (vertical) {
            const dx = (index - 1) * r * .48;
            routes.push([
              cx + dx,
              cy + Math.sqrt(Math.max(0, r * r - dx * dx)),
              b.left - box.left + b.width / 2,
              b.top - box.top
            ]);
          } else {
            routes.push([x1, y1, b.left - box.left, b.top - box.top + b.height / 2]);
          }
        });

        svg.replaceChildren();

        routes.forEach(function (route) {
          const x1 = route[0];
          const y1 = route[1];
          const x2 = route[2];
          const y2 = route[3];
          const path = document.createElementNS(ns, "path");
          const bend = Math.max(14, (x2 - x1) * .52);
          const vbend = Math.max(14, (y2 - y1) * .5);

          path.setAttribute("d", vertical
            ? "M " + x1 + " " + y1 + " C " + x1 + " " + (y1 + vbend) + ", " + x2 + " " + (y2 - vbend) + ", " + x2 + " " + y2
            : "M " + x1 + " " + y1 + " C " + (x1 + bend) + " " + y1 + ", " + (x2 - bend) + " " + y2 + ", " + x2 + " " + y2);
          path.setAttribute("fill", "none");
          path.setAttribute("stroke", "#45cdbb");
          path.setAttribute("stroke-width", "1.7");
          path.setAttribute("stroke-dasharray", "5 7");
          svg.append(path);

          [[x1, y1], [x2, y2]].forEach(function (point) {
            const dot = document.createElementNS(ns, "circle");
            dot.setAttribute("cx", point[0]);
            dot.setAttribute("cy", point[1]);
            dot.setAttribute("r", "4.5");
            dot.setAttribute("fill", "#fff");
            dot.setAttribute("stroke", "#43cdbb");
            dot.setAttribute("stroke-width", "2");
            svg.append(dot);
          });
        });
      }

      if ("ResizeObserver" in window) {
        new ResizeObserver(draw).observe(stage);
      }

      window.addEventListener("resize", draw, { passive: true });
      stage.querySelectorAll("img").forEach(function (img) {
        if (!img.complete) img.addEventListener("load", draw, { once: true });
      });

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(draw);
      }

      requestAnimationFrame(draw);
    }

    document.querySelectorAll(".pc-standalone").forEach(initPunchoutStandalone);
  })();
</script>


