          <path d="M130 265 C215 265 235 170 316 170"></path>
          <path d="M364 170 C445 170 465 75 550 75"></path>
          <path d="M364 170 C445 170 465 170 550 170"></path>
          <path d="M364 170 C445 170 465 265 550 265"></path>
        </svg>

        <div class="punchout-architecture__stack punchout-architecture__stack--procurement">
          <span class="punchout-architecture__mobile-label">Buyer procurement</span>
          <span class="punchout-architecture__logo-card">
            <img src="https://cdn.brandfetch.io/idDyM4WKXD/theme/dark/logo.svg?c=1bxid64Mup7aczewSAYMX&t=1690523448165" alt="Coupa" loading="lazy" decoding="async">
          </span>
          <span class="punchout-architecture__logo-card punchout-architecture__logo-card--sap">
            <img src="https://upload.wikimedia.org/wikipedia/commons/5/59/SAP_2011_logo.svg" alt="SAP Ariba" loading="lazy" decoding="async">
          </span>
