<main>

<section class="page-hero page-hero--mint" id="overview">
  <div class="wrap page-hero__grid">
    <div class="page-hero__copy reveal">
      <span class="ey">PunchOut</span>
      <h1>When your customer asks for PunchOut, say yes.</h1>
      <p class="lead">Connect enterprise procurement systems to your Shopify catalog without turning every buyer into a custom integration project.</p>
      <div class="page-hero__actions">
         <a class="btn pri" href="https://app.punchoutcentral.com/platform/register" target="_blank">Connect my first buyer <span aria-hidden="true">→</span></a>
        <a class="btn secbtn" href="#details">See how it works <span aria-hidden="true">↓</span></a>
      </div>
      <div class="page-proofline">
        <span><b>✓</b> Free Integration</span>
        <span><b>✓</b> Cancel anytime</span>
        <span><b>✓</b> No transaction fees</span>
      </div>
    </div>
    
    <div class="punchout-architecture reveal" aria-label="PunchOut Central connects procurement platforms to ecommerce platforms">
      <div class="punchout-architecture__labels" aria-hidden="true">
        <span>Buyer procurement</span>
        <span>PunchOut Central</span>
        <span>Your commerce</span>
      </div>

      <div class="punchout-architecture__flow">
        <svg class="punchout-architecture__connectors" viewBox="0 0 680 340" preserveAspectRatio="none" aria-hidden="true">
          <path d="M130 75 C215 75 235 170 316 170"></path>
