            <svg viewBox="0 0 64 64">
              <path d="M14 22h22a8 8 0 0 1 8 8v12"></path>
              <path d="M32 16l6 6-6 6"></path>
              <rect x="10" y="16" width="18" height="12" rx="4"></rect>
              <rect x="36" y="36" width="18" height="12" rx="4"></rect>
            </svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">01</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6.8 12.4l3.2 3.2 7.2-7.3"></path></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>PunchOut Started</h3>
            <p>The buyer opens your Shopify catalog from their procurement system.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="1">
