<section class="sec soft" id="workflow">
  <div class="wrap">
    <div class="po-section-head center reveal">
      <span class="ey">One connected transaction</span>
      <h2>From PunchOut to invoice. Nothing gets lost in between.</h2>
      <p class="lead">Every step stays connected to the same buyer transaction.</p>
    </div>

    <div class="pc-order-shell reveal" id="pcOrderFlowPlatform" aria-label="PunchOut order process">
      <div class="pc-order-progress pc-order-progress--integrated">
        <div class="pc-order-progress__main">
          <div class="pc-order-progress__action">
            <span class="pc-order-progress__pulse"></span>
            <div>
              <span class="pc-order-progress__kicker" id="pcOrderStepLabelPlatform">Step 1 of 6</span>
              <strong id="pcOrderStatusPlatform">Starting PunchOut session...</strong>
            </div>
          </div>

          <div class="pc-order-progress__metric" aria-label="Order completion percentage">
            <strong>
              <span id="pcOrderPercentPlatform">0</span>
              <span class="pc-order-progress__symbol">%</span>
              <span class="pc-order-progress__complete-label">Complete</span>
            </strong>
          </div>
        </div>
      </div>

      <div class="pc-order-route" aria-hidden="true">
        <div class="pc-order-route__line">
          <span class="pc-order-route__fill"></span>
          <span class="pc-order-route__packet"><span></span></span>
        </div>

        <div class="pc-order-route__nodes">
          <span class="pc-order-route__node is-current" data-node="0"></span>
          <span class="pc-order-route__node" data-node="1"></span>
          <span class="pc-order-route__node" data-node="2"></span>
          <span class="pc-order-route__node" data-node="3"></span>
          <span class="pc-order-route__node" data-node="4"></span>
          <span class="pc-order-route__node" data-node="5"></span>
        </div>
      </div>

      <div class="pc-order-flow pc-order-flow--synced">
        <article class="pc-order-step" data-step="0">
