            <svg viewBox="0 0 64 64">
              <path d="M12 18h8l4 22h24l4-16H22"></path>
              <circle cx="28" cy="48" r="3"></circle>
              <circle cx="46" cy="48" r="3"></circle>
              <path d="M47 12l6 6-6 6"></path>
            </svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">02</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6.8 12.4l3.2 3.2 7.2-7.3"></path></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>Cart Returned</h3>
            <p>The cart and order details go back to the buyer's procurement system.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="2">
