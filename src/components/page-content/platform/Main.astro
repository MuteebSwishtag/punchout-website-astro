<script is:inline>
(() => {
  const flow = document.getElementById('pcOrderFlowPlatform');
  if (!flow) return;

  const shell = flow.closest('.pc-order-shell');
  const route = flow.querySelector('.pc-order-route');
  const steps = Array.from(flow.querySelectorAll('.pc-order-step'));
  const nodes = Array.from(flow.querySelectorAll('.pc-order-route__node'));
  const percentEl = document.getElementById('pcOrderPercentPlatform');
  const statusEl = document.getElementById('pcOrderStatusPlatform');
  const stepLabelEl = document.getElementById('pcOrderStepLabelPlatform');
  const restartBtn = document.getElementById('pcOrderRestartPlatform');
  const confetti = document.getElementById('pcOrderConfettiPlatform');
  const celebration = shell?.querySelector('.pc-order-celebration');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (
    !shell || !route || !steps.length || !percentEl || !statusEl ||
    !stepLabelEl || !restartBtn || !confetti || !celebration
  ) return;

  const stepMessages = [
    'Starting PunchOut session...',
    'Returning cart to procurement...',
    'Waiting for buyer approval...',
    'Receiving approved purchase order...',
    'Creating Shopify order...',
    'Generating invoice...'
  ];

  const completeMessages = [
    'PunchOut session started',
    'Cart returned successfully',
    'Buyer approval completed',
    'Purchase order received',
    'Shopify order created',
    'Invoice generated'
  ];

  let timers = [];
  let running = false;
  let visible = false;
  let finished = false;
  let currentPercent = 0;

  const wait = (ms) => new Promise(resolve => {
    const id = window.setTimeout(resolve, ms);
    timers.push(id);
  });

  const clearTimers = () => {
    timers.forEach(window.clearTimeout);
    timers = [];
  };

  const setCardText = (step, text) => {
    const el = step.querySelector('.pc-order-step__state-text');
    if (el) el.textContent = text;
  };

  const checkpointPercent = (index) => {
    const max = Math.max(steps.length - 1, 1);
    return (index / max) * 100;
  };

  const completedPercent = (index) => Math.round(((index + 1) / steps.length) * 100);

  const animatePercent = (from, to, duration = 460) => {
    const startTime = performance.now();

    return new Promise(resolve => {
      const tick = (now) => {
        if (!running || !visible) return resolve();

        const p = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        percentEl.textContent = String(Math.round(from + (to - from) * eased));

        if (p < 1) requestAnimationFrame(tick);
        else resolve();
      };

      requestAnimationFrame(tick);
    });
  };

  const setCheckpointState = (currentIndex) => {
    nodes.forEach((node, i) => {
      node.classList.toggle('is-current', i === currentIndex);
      node.classList.toggle('is-complete', i < currentIndex);
    });
  };

  const clearConfetti = () => {
    confetti.innerHTML = '';
  };

  const fireConfetti = () => {
    clearConfetti();
    if (reduceMotion.matches) return;

    const colors = ['#C2FF02', '#99FEED', '#D9D6FD', '#FFBD9B', '#202124', '#FFFFFF'];
    const pieces = 140;

    for (let i = 0; i < pieces; i++) {
      const piece = document.createElement('span');
      piece.className = 'pc-order-confetti__piece';

      const x = 2 + Math.random() * 96;
      const y = -8 + Math.random() * 36;
      const w = 4 + Math.random() * 7;
      const h = Math.random() > .35 ? 8 + Math.random() * 12 : w;
      const radius = Math.random() > .65 ? '50%' : `${Math.random() * 3}px`;
      const drift = -180 + Math.random() * 360;
      const fall = 360 + Math.random() * 280;
      const startRot = -90 + Math.random() * 180;
      const rot = 360 + Math.random() * 900;
      const scale = .72 + Math.random() * .72;
      const duration = 2200 + Math.random() * 650;
      const delay = Math.random() * 180;
      const color = colors[Math.floor(Math.random() * colors.length)];

      piece.style.setProperty('--x', `${x}%`);
      piece.style.setProperty('--y', `${y}%`);
      piece.style.setProperty('--w', `${w}px`);
      piece.style.setProperty('--h', `${h}px`);
      piece.style.setProperty('--radius', radius);
      piece.style.setProperty('--drift', `${drift}px`);
      piece.style.setProperty('--fall', `${fall}px`);
      piece.style.setProperty('--start-rot', `${startRot}deg`);
      piece.style.setProperty('--rot', `${rot}deg`);
      piece.style.setProperty('--scale', scale.toFixed(2));
      piece.style.setProperty('--d', `${duration}ms`);
      piece.style.setProperty('--delay', `${delay}ms`);
      piece.style.setProperty('--c', color);

      confetti.appendChild(piece);
    }

    window.setTimeout(clearConfetti, 3050);
  };

  const reset = () => {
    clearTimers();
    clearConfetti();

    finished = false;
    currentPercent = 0;
    shell.classList.remove('is-finished');
    celebration.setAttribute('aria-hidden', 'true');

    percentEl.textContent = '0';
    flow.style.setProperty('--pc-route', '0%');
    statusEl.textContent = stepMessages[0];
    stepLabelEl.textContent = `Step 1 of ${steps.length}`;
    route.classList.remove('is-travelling');

    steps.forEach((step, i) => {
      step.classList.remove('is-active', 'is-complete');
      step.classList.toggle('is-waiting', i !== 0);
      setCardText(step, 'Waiting');
    });

    nodes.forEach((node, i) => {
      node.classList.remove('is-complete');
      node.classList.toggle('is-current', i === 0);
    });
  };

  const travelToCheckpoint = async (nextIndex) => {
    if (!running || !visible || finished) return;

    statusEl.textContent = 'Moving order to the next checkpoint...';
    stepLabelEl.textContent = `Moving to step ${nextIndex + 1} of ${steps.length}`;

    nodes.forEach(node => node.classList.remove('is-current'));
    route.classList.remove('is-travelling');
    await wait(0);
    if (!running || !visible || finished) return;
    route.classList.add('is-travelling');
    flow.style.setProperty('--pc-route', `${checkpointPercent(nextIndex)}%`);

    await wait(630);
    if (!running || !visible || finished) return;

    route.classList.remove('is-travelling');
    setCheckpointState(nextIndex);
    stepLabelEl.textContent = `Step ${nextIndex + 1} of ${steps.length}`;
  };

  const finishJourney = () => {
    finished = true;
    running = false;
    clearTimers();
    route.classList.remove('is-travelling');

    nodes.forEach(node => {
      node.classList.remove('is-current');
      node.classList.add('is-complete');
    });

    flow.style.setProperty('--pc-route', '100%');
    percentEl.textContent = '100';
    currentPercent = 100;
    statusEl.textContent = 'Order completed successfully';
    stepLabelEl.textContent = '6 of 6 steps complete';

    shell.classList.add('is-finished');
    celebration.setAttribute('aria-hidden', 'false');
    fireConfetti();
  };

  const processStep = async (index) => {
    if (!running || !visible || finished) return;

    const step = steps[index];

    step.classList.remove('is-waiting');
    step.classList.add('is-active');
    statusEl.textContent = stepMessages[index];
    stepLabelEl.textContent = `Step ${index + 1} of ${steps.length}`;
    setCardText(step, 'Processing');

    await wait(550);
    if (!running || !visible || finished) return;

    step.classList.remove('is-active');
    step.classList.add('is-complete');
    setCardText(step, 'Complete');
    statusEl.textContent = completeMessages[index];

    await wait(90);
    if (!running || !visible || finished) return;

    const targetPercent = completedPercent(index);
    await animatePercent(currentPercent, targetPercent, 280);
    currentPercent = targetPercent;

    await wait(260);
    if (!running || !visible || finished) return;

    if (index < steps.length - 1) {
      const next = index + 1;
      await travelToCheckpoint(next);
      if (!running || !visible || finished) return;
      await wait(80);
      await processStep(next);
    } else {
      finishJourney();
    }
  };

  const start = () => {
    if (running || finished) return;

    running = true;
    reset();

    if (reduceMotion.matches) {
      steps.forEach(step => {
        step.classList.remove('is-waiting');
        step.classList.add('is-complete');
        setCardText(step, 'Complete');
      });
      finishJourney();
      return;
    }

    wait(280).then(() => {
      if (running && visible && !finished) processStep(0);
    });
  };

  const stop = () => {
    if (finished) return;
    running = false;
    clearTimers();
    route.classList.remove('is-travelling');
  };

  const restart = () => {
    running = false;
    finished = false;
    reset();

    if (!visible) return;

    running = true;
    wait(180).then(() => {
      if (running && visible && !finished) processStep(0);
    });
  };

  restartBtn.addEventListener('click', restart);

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      visible = entry.isIntersecting && entry.intersectionRatio > 0.22;

      if (visible) {
        if (!running && !finished) start();
      } else {
        stop();
      }
    });
  }, { threshold:[0,.22,.5] });

  observer.observe(flow);

  reduceMotion.addEventListener?.('change', () => {
    running = false;
    finished = false;
    reset();
    if (visible) start();
  });
})();
</script>
