---
---
<main>
<section class="po-hero" id="overview" aria-labelledby="platformTitle">
  <div class="wrap po-hero__grid">
    <div class="po-hero__copy reveal">
      <span class="ey">Platform Overview</span>
      <h1 id="platformTitle">Connect Shopify commerce to enterprise procurement.</h1>
      <p class="lead">
        Keep the Shopify or Shopify Plus store you already use. Manage buyer connections, cXML and OCI PunchOut activity, purchase orders, store orders and invoices from one central platform.
      </p>

      <div class="po-hero__acts">
         <a class="btn pri" href="/book-demo/">Discuss your buyer setup <span aria-hidden="true">→</span></a>
        <a class="btn secbtn" href="#modules">Explore the platform <span aria-hidden="true">↓</span></a>
      </div>

      <div class="po-hero__proof">
        <span><b>✓</b> No setup fee</span>
        <span><b>✓</b> Free onboarding assistance</span>
        <span><b>✓</b> No transaction fees</span>
      </div>
    </div>

    <div class="po-platform-map reveal" aria-label="PunchOut Central connects procurement systems to ecommerce and manages the complete transaction">
      <div class="po-platform-route" aria-hidden="true">
        <svg focusable="false"></svg>
      </div>

      <div class="po-map-side po-map-side--procurement">
        <span class="po-map-side__label">Procurement</span>
        <span class="po-logo-pill" style="--brand-scale:1.0"><img src="/assets/logos/coupa.svg" alt="Coupa" loading="lazy" decoding="async"></span>
<span class="po-logo-pill" style="--brand-scale:0.95"><img src="/assets/logos/sap-ariba.png" alt="SAP Ariba" loading="lazy" decoding="async"></span>
<span class="po-logo-pill" style="--brand-scale:0.82"><img src="/assets/logos/jaggaer.png" alt="JAGGAER" loading="lazy" decoding="async"></span>
<span class="po-logo-pill" style="--brand-scale:0.86"><img src="/assets/logos/oracle.svg" alt="Oracle Procurement Cloud" loading="lazy" decoding="async"></span>
      </div>

      <div class="po-platform-core">
        <div class="po-platform-core__head">
          <span>PunchOut Central</span>
          <strong>Control Center</strong>
        </div>
        <div class="po-platform-core__rows">
          <div class="po-core-row"><span><i></i>Buyer connections</span><b>Connected</b></div>
          <div class="po-core-row"><span><i></i>PunchOut sessions</span><b>Tracked</b></div>
          <div class="po-core-row"><span><i></i>Returned carts</span><b>Linked</b></div>
          <div class="po-core-row"><span><i></i>Purchase orders</span><b>Received</b></div>
          <div class="po-core-row"><span><i></i>Store orders</span><b>Created</b></div>
          <div class="po-core-row"><span><i></i>Invoices</span><b>Connected</b></div>
        </div>
      </div>

      <div class="po-map-side po-map-side--commerce">
        <span class="po-map-side__label">Commerce</span>
        <span class="po-logo-pill" style="--brand-scale:1.12"><img src="/assets/logos/shopify.svg" alt="Shopify" loading="lazy" decoding="async"></span>
      </div>
    </div>
  </div>
</section>



<section class="sec" id="modules">
  <div class="wrap">
    <div class="po-section-head reveal">
      <span class="ey">Everything works together</span>
      <h2>Five product capabilities and one connected workflow.</h2>
      <p class="lead">Use what you need today. The transaction stays connected as your buyer moves from PunchOut to purchase order to invoice.</p>
    </div>

    <div class="po-modules">
      <a class="po-module reveal" href="/platform/punchout/">
        <span class="po-module__icon"><svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-module-punchout" width="100%" height="100%"></use></svg></span>
        <span class="po-module__kicker">01 · Connect</span>
        <h3>PunchOut</h3>
        <p>Authenticate the buyer, launch the catalog session and return the cart to procurement.</p>
        <span class="po-module__link">Explore PunchOut →</span>
      </a>

      <a class="po-module reveal" href="/platform/purchase-orders/">
        <span class="po-module__icon"><svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-module-po" width="100%" height="100%"></use></svg></span>
        <span class="po-module__kicker">02 · Automate</span>
        <h3>Purchase Orders</h3>
        <p>Receive approved POs and create the related Shopify orders.</p>
        <span class="po-module__link">Explore Purchase Orders →</span>
      </a>

      <a class="po-module reveal" href="/platform/invoices/">
        <span class="po-module__icon"><svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-module-invoice" width="100%" height="100%"></use></svg></span>
        <span class="po-module__kicker">03 · Complete</span>
        <h3>Invoices</h3>
        <p>Keep invoice activity connected to the original buyer, PO and store order.</p>
        <span class="po-module__link">Explore Invoices →</span>
      </a>

      <a class="po-module reveal" href="/platform/multi-store/">
        <span class="po-module__icon"><svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-module-store" width="100%" height="100%"></use></svg></span>
        <span class="po-module__kicker">04 · Centralize</span>
        <h3>Multi-Store Control</h3>
        <p>Manage multiple enterprise buyers, gateway connections and storefronts from one account.</p>
        <span class="po-module__link">Explore Multi-Store →</span>
      </a>

      <a class="po-module reveal" href="/platform/transactions/">
        <span class="po-module__icon"><svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-module-transactions" width="100%" height="100%"></use></svg></span>
        <span class="po-module__kicker">05 · See</span>
        <h3>Transactions</h3>
        <p>See what happened across sessions, carts, POs, orders, invoices and failed transactions.</p>
        <span class="po-module__link">Explore Transactions →</span>
      </a>

      <a class="po-module reveal" href="/how-it-works/">
        <span class="po-module__icon"><svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-module-journey" width="100%" height="100%"></use></svg></span>
        <span class="po-module__kicker">06 · Understand</span>
        <h3>How It Works</h3>
        <p>See the complete buyer journey in six simple steps from PunchOut session to invoice.</p>
        <span class="po-module__link">See the workflow →</span>
      </a>
    </div>
  </div>
</section>

<section class="sec soft" id="workflow">
  <div class="wrap">
    <div class="po-section-head center reveal">
      <span class="ey">One connected transaction</span>
      <h2>Trace the transaction from PunchOut to invoice.</h2>
      <p class="lead">Follow the six stages so your team can see progress and locate a failure.</p>
    </div>

    <div class="pc-order-shell reveal" id="pcOrderFlowPlatform" aria-label="PunchOut order process">
      <div class="pc-order-progress pc-order-progress--integrated">
        <div class="pc-order-progress__main">
          <div class="pc-order-progress__action">
            <span class="pc-order-progress__pulse"></span>
            <div>
              <span class="pc-order-progress__kicker" id="pcOrderStepLabelPlatform">Step 1 of 6</span>
              <strong id="pcOrderStatusPlatform">Starting PunchOut session...</strong>
            </div>
          </div>

          <div class="pc-order-progress__metric" aria-label="Order completion percentage">
            <strong>
              <span id="pcOrderPercentPlatform">0</span>
              <span class="pc-order-progress__symbol">%</span>
              <span class="pc-order-progress__complete-label">Complete</span>
            </strong>
          </div>
        </div>
      </div>

      <div class="pc-order-route" aria-hidden="true">
        <div class="pc-order-route__line">
          <span class="pc-order-route__fill"></span>
          <span class="pc-order-route__packet"><span></span></span>
        </div>

        <div class="pc-order-route__nodes">
          <span class="pc-order-route__node is-current" data-node="0"></span>
          <span class="pc-order-route__node" data-node="1"></span>
          <span class="pc-order-route__node" data-node="2"></span>
          <span class="pc-order-route__node" data-node="3"></span>
          <span class="pc-order-route__node" data-node="4"></span>
          <span class="pc-order-route__node" data-node="5"></span>
        </div>
      </div>

      <div class="pc-order-flow pc-order-flow--synced">
        <article class="pc-order-step" data-step="0">
          <div class="pc-order-step__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="/assets/ui-icons.svg#platform-order-punchout" width="100%" height="100%"></use></svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">01</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-order-check-1" width="100%" height="100%"></use></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>PunchOut Started</h3>
            <p>The buyer opens your Shopify catalog from their procurement system.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="1">
          <div class="pc-order-step__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="/assets/ui-icons.svg#platform-order-cart" width="100%" height="100%"></use></svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">02</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-order-check-2" width="100%" height="100%"></use></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>Cart Returned</h3>
            <p>The cart and order details go back to the buyer's procurement system.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="2">
          <div class="pc-order-step__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="/assets/ui-icons.svg#platform-order-approved" width="100%" height="100%"></use></svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">03</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-order-check-3" width="100%" height="100%"></use></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>Buyer Approved</h3>
            <p>The buyer's team reviews and approves the purchase in their procurement system.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="3">
          <div class="pc-order-step__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="/assets/ui-icons.svg#platform-order-po" width="100%" height="100%"></use></svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">04</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-order-check-4" width="100%" height="100%"></use></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>PO Received</h3>
            <p>The approved purchase order arrives in PunchOut Central for a quick preview.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="4">
          <div class="pc-order-step__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="/assets/ui-icons.svg#platform-order-store" width="100%" height="100%"></use></svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">05</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-order-check-5" width="100%" height="100%"></use></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>Store Order Created</h3>
            <p>PunchOut Central automatically creates the matching order in Shopify.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>

        <article class="pc-order-step" data-step="5">
          <div class="pc-order-step__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="/assets/ui-icons.svg#platform-order-invoice" width="100%" height="100%"></use></svg>
          </div>
          <div class="pc-order-step__meta">
            <span class="pc-order-step__num">06</span>
            <span class="pc-order-step__check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/ui-icons.svg#platform-order-check-6" width="100%" height="100%"></use></svg>
            </span>
          </div>
          <div class="pc-order-step__body">
            <h3>Invoice Generated</h3>
            <p>The invoice stays linked to the buyer and PO, with a quick preview in PunchOut Central.</p>
          </div>
          <div class="pc-order-step__state">
            <span class="pc-order-step__state-dot"></span>
            <span class="pc-order-step__state-text">Waiting</span>
          </div>
        </article>
      </div>

      <div class="pc-order-process__close">
        <div>
          <strong>Six steps. One connected order.</strong>
          <span>PunchOut Central handles the technical flow so you can focus on the customer.</span>
        </div>
      </div>

      <div class="pc-order-celebration" aria-hidden="true">
        <div class="pc-order-celebration__card">
          <span class="pc-order-celebration__eyebrow">Order Completed</span>
          <h3>Transaction journey complete.</h3>
          <p>
            Congratulations. Your order moved through all six steps.
            <strong>That's how easy PunchOut can feel.</strong>
          </p>

          <button class="pc-order-restart" id="pcOrderRestartPlatform" type="button" aria-label="Replay the order journey">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="/assets/ui-icons.svg#platform-order-replay" width="100%" height="100%"></use></svg>
            <span>Replay the order</span>
          </button>
        </div>
      </div>

      <div class="pc-order-confetti" id="pcOrderConfettiPlatform" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="sec" id="control">
  <div class="wrap po-control">
    <div class="hero-visual reveal" aria-label="Illustration of a buyer transaction moving from PunchOut to invoice">
      <div class="hero-visual__label"><span>Illustrative workflow</span><b>One transaction</b></div>
      <div class="visual-flow">
        <div class="visual-step is-accent"><i>01</i><span><strong>Buyer connection</strong><small>Store and catalog access assigned</small></span></div>
        <div class="visual-step is-lavender"><i>02</i><span><strong>Cart returned</strong><small>Buyer reviews in procurement</small></span></div>
        <div class="visual-step is-peach"><i>03</i><span><strong>PO received</strong><small>Approved purchase order</small></span></div>
        <div class="visual-step is-lime"><i>04</i><span><strong>Order and invoice</strong><small>Stages tracked together</small></span></div>
      </div>
    </div>

    <div class="po-control__copy reveal">
      <span class="ey">Control Center</span>
      <h2>One place for every buyer, store and transaction.</h2>
      <p class="lead">You should not need five systems to answer one simple question: “What happened to this order?”</p>
      <ul>
        <li><b>✓</b><span>See every enterprise buyer and connection.</span></li>
        <li><b>✓</b><span>Follow the order from session to invoice.</span></li>
        <li><b>✓</b><span>See where a transaction stopped and why.</span></li>
        <li><b>✓</b><span>Manage multiple Shopify stores from one account.</span></li>
      </ul>
    </div>
  </div>
</section>

<section class="sec soft" id="reliability">
  <div class="wrap">
    <div class="po-section-head reveal">
      <span class="ey">Operating models</span>
      <h2>One store with many buyers, or several stores together.</h2>
      <p class="lead">Assign the right store and catalog access to each buyer, then follow transactions across those connections.</p>
    </div>

    <div class="po-proof-grid">
      <article class="po-proof-card reveal"><strong>One store</strong><span>Serve multiple enterprise buyers from your existing Shopify store.</span></article>
      <article class="po-proof-card reveal"><strong>Multiple stores</strong><span>Manage stores and buyer connections from one central platform.</span></article>
      <article class="po-proof-card po-proof-card--dark reveal"><strong>cXML + OCI.<br>Tracked end to end.</strong><span>Buyer sessions, carts, POs, store orders and invoices stay connected and visible.</span></article>
    </div>
  </div>
</section>

<section class="sec" id="scale">
  <div class="wrap">
    <div class="po-section-head reveal">
      <span class="ey">Start small. Grow cleanly.</span>
      <h2>Start with one buyer. Add more without rebuilding the platform.</h2>
    </div>

    <div class="po-scale">
      <article class="po-scale-card po-scale-card--mint reveal">
        <span class="ey">Launch</span>
        <h3>Start when the first enterprise opportunity arrives.</h3>
        <div class="po-price"><strong>$500</strong><span>/ month</span></div>
        <div class="po-scale-list">
          <span><b>✓</b> 1 enterprise buyer connection</span>
          <span><b>✓</b> No setup fee</span>
          <span><b>✓</b> No transaction fees</span>
          <span><b>✓</b> Free onboarding assistance</span>
        </div>
      </article>

      <article class="po-scale-card reveal">
        <span class="ey">Grow</span>
        <h3>Add buyers, stores and connections from the same control center.</h3>
        <p class="lead" style="font-size:15px">The platform is designed so the next supported connection becomes configuration, not another custom software project.</p>
        <div class="po-scale-list">
          <span><b>✓</b> Multiple procurement platforms</span>
          <span><b>✓</b> Multiple ecommerce stores</span>
          <span><b>✓</b> Central reporting and transaction visibility</span>
          <span><b>✓</b> Growth includes up to 4 connections</span>
          <span><b>✓</b> Scale includes up to 7 connections</span>
          <span><b>✓</b> Each additional connection is $200/month</span>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="sec soft" id="faq">
  <div class="wrap">
    <div class="po-section-head center reveal">
      <span class="ey">Platform FAQ</span>
      <h2>Questions suppliers usually ask.</h2>
    </div>

    <div class="faq reveal">
      <div class="fi">
        <button class="fq" type="button"><span>Do I need every module to use PunchOut Central?</span><span class="plus">+</span></button>
        <div class="fa"><p>No. PunchOut Central is one connected platform, but you start with the capabilities your buyer requires. The transaction data stays connected as your usage grows.</p></div>
      </div>
      <div class="fi">
        <button class="fq" type="button"><span>Does PunchOut Central work with Shopify?</span><span class="plus">+</span></button>
        <div class="fa"><p>Yes. Shopify is the supported commerce connector. BigCommerce and Magento / Adobe Commerce are coming soon.</p></div>
      </div>
      <div class="fi">
        <button class="fq" type="button"><span>Which procurement systems can we connect?</span><span class="plus">+</span></button>
        <div class="fa"><p>PunchOut Central supports cXML and OCI workflows for Coupa, GEP SMART, Ivalua, JAGGAER ONE, Oracle Fusion Procurement and SAP Ariba.</p></div>
      </div>
      <div class="fi">
        <button class="fq" type="button"><span>When is the Shopify order created?</span><span class="plus">+</span></button>
        <div class="fa"><p>After the buyer completes approval and the approved purchase order is received. Returning a PunchOut cart does not create the final Shopify order.</p></div>
      </div>
      <div class="fi">
        <button class="fq" type="button"><span>Can we manage more than one buyer or store?</span><span class="plus">+</span></button>
        <div class="fa"><p>Yes. Multi-Store Control is designed for multiple enterprise buyer connections and multiple ecommerce storefronts inside the same account.</p></div>
      </div>
      <div class="fi">
        <button class="fq" type="button"><span>Is onboarding assistance included?</span><span class="plus">+</span></button>
        <div class="fa"><p>Yes. Onboarding assistance is free: connect your store, add a buyer, test the PunchOut flow and go live.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="sec" aria-label="Explore related topics"><div class="wrap"><div class="section-head reveal"><span class="ey">Choose a path</span><h2>Find the buyer problem or integration you need.</h2></div><div class="related-grid">
  <a class="related-card reveal" href="/solutions/"><span>Business use cases</span><h3>PunchOut solutions</h3><p>Compare one-store, multi-store and buyer onboarding models.</p><b>Explore &rarr;</b></a>
  <a class="related-card reveal" href="/integrations/"><span>Connections</span><h3>Shopify and procurement integrations</h3><p>Review supplier storefronts, buyer systems, cXML and OCI.</p><b>Explore &rarr;</b></a>
  <a class="related-card reveal" href="/documentation/"><span>Setup</span><h3>Documentation</h3><p>Prepare your Shopify store, buyer access and end-to-end test.</p><b>Explore &rarr;</b></a>
</div></div></section>

<section class="po-cta">
  <div class="wrap reveal">
    <span class="ey">Ready when the buyer is</span>
    <h2>Give your team one platform to say yes to bigger opportunities.</h2>
    <p class="lead">Start with your first enterprise buyer. Keep the connection, orders and visibility in one place.</p>
    <div class="po-hero__acts">
       <a class="btn pri" href="/book-demo/">Request a demo <span aria-hidden="true">→</span></a>
      <a class="btn secbtn" href="/pricing/">See pricing</a>
    </div>
  </div>
</section>
</main>

<script>
  import { watchDiagramConnectors } from '../../../scripts/diagram-connectors.js';

  const stage = document.querySelector('.po-platform-map');
  if (stage) watchDiagramConnectors({
    stage,
    svg: stage.querySelector('.po-platform-route svg'),
    hub: stage.querySelector('.po-platform-core'),
    sources: '.po-map-side--procurement .po-logo-pill',
    targets: '.po-map-side--commerce .po-logo-pill',
    shape: 'rectangle'
  });
</script>

<script is:inline>
(() => {
  const flow = document.getElementById('pcOrderFlowPlatform');
  if (!flow) return;

  const shell = flow.closest('.pc-order-shell');
  const route = flow.querySelector('.pc-order-route');
  const steps = Array.from(flow.querySelectorAll('.pc-order-step'));
  const nodes = Array.from(flow.querySelectorAll('.pc-order-route__node'));
  const percentEl = document.getElementById('pcOrderPercentPlatform');
  const statusEl = document.getElementById('pcOrderStatusPlatform');
  const stepLabelEl = document.getElementById('pcOrderStepLabelPlatform');
  const restartBtn = document.getElementById('pcOrderRestartPlatform');
  const confetti = document.getElementById('pcOrderConfettiPlatform');
  const celebration = shell?.querySelector('.pc-order-celebration');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (
    !shell || !route || !steps.length || !percentEl || !statusEl ||
    !stepLabelEl || !restartBtn || !confetti || !celebration
  ) return;

  const stepMessages = [
    'Starting PunchOut session...',
    'Returning cart to procurement...',
    'Waiting for buyer approval...',
    'Receiving approved purchase order...',
    'Creating Shopify order...',
    'Generating invoice...'
  ];

  const completeMessages = [
    'PunchOut session started',
    'Cart returned successfully',
    'Buyer approval completed',
    'Purchase order received',
    'Shopify order created',
    'Invoice generated'
  ];

  let timers = [];
  let running = false;
  let visible = false;
  let finished = false;
  let currentPercent = 0;

  const wait = (ms) => new Promise(resolve => {
    const id = window.setTimeout(resolve, ms);
    timers.push(id);
  });

  const clearTimers = () => {
    timers.forEach(window.clearTimeout);
    timers = [];
  };

  const setCardText = (step, text) => {
    const el = step.querySelector('.pc-order-step__state-text');
    if (el) el.textContent = text;
  };

  const checkpointPercent = (index) => {
    const max = Math.max(steps.length - 1, 1);
    return (index / max) * 100;
  };

  const completedPercent = (index) => Math.round(((index + 1) / steps.length) * 100);

  const animatePercent = (from, to, duration = 460) => {
    const startTime = performance.now();

    return new Promise(resolve => {
      const tick = (now) => {
        if (!running || !visible) return resolve();

        const p = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        percentEl.textContent = String(Math.round(from + (to - from) * eased));

        if (p < 1) requestAnimationFrame(tick);
        else resolve();
      };

      requestAnimationFrame(tick);
    });
  };

  const setCheckpointState = (currentIndex) => {
    nodes.forEach((node, i) => {
      node.classList.toggle('is-current', i === currentIndex);
      node.classList.toggle('is-complete', i < currentIndex);
    });
  };

  const clearConfetti = () => {
    confetti.innerHTML = '';
  };

  const fireConfetti = () => {
    clearConfetti();
    if (reduceMotion.matches) return;

    const colors = ['#C2FF02', '#99FEED', '#D9D6FD', '#FFBD9B', '#202124', '#FFFFFF'];
    const pieces = 140;

    for (let i = 0; i < pieces; i++) {
      const piece = document.createElement('span');
      piece.className = 'pc-order-confetti__piece';

      const x = 2 + Math.random() * 96;
      const y = -8 + Math.random() * 36;
      const w = 4 + Math.random() * 7;
      const h = Math.random() > .35 ? 8 + Math.random() * 12 : w;
      const radius = Math.random() > .65 ? '50%' : `${Math.random() * 3}px`;
      const drift = -180 + Math.random() * 360;
      const fall = 360 + Math.random() * 280;
      const startRot = -90 + Math.random() * 180;
      const rot = 360 + Math.random() * 900;
      const scale = .72 + Math.random() * .72;
      const duration = 2200 + Math.random() * 650;
      const delay = Math.random() * 180;
      const color = colors[Math.floor(Math.random() * colors.length)];

      piece.style.setProperty('--x', `${x}%`);
      piece.style.setProperty('--y', `${y}%`);
      piece.style.setProperty('--w', `${w}px`);
      piece.style.setProperty('--h', `${h}px`);
      piece.style.setProperty('--radius', radius);
      piece.style.setProperty('--drift', `${drift}px`);
      piece.style.setProperty('--fall', `${fall}px`);
      piece.style.setProperty('--start-rot', `${startRot}deg`);
      piece.style.setProperty('--rot', `${rot}deg`);
      piece.style.setProperty('--scale', scale.toFixed(2));
      piece.style.setProperty('--d', `${duration}ms`);
      piece.style.setProperty('--delay', `${delay}ms`);
      piece.style.setProperty('--c', color);

      confetti.appendChild(piece);
    }

    window.setTimeout(clearConfetti, 3050);
  };

  const reset = () => {
    clearTimers();
    clearConfetti();

    finished = false;
    currentPercent = 0;
    shell.classList.remove('is-finished');
    celebration.setAttribute('aria-hidden', 'true');

    percentEl.textContent = '0';
    flow.style.setProperty('--pc-route', '0%');
    statusEl.textContent = stepMessages[0];
    stepLabelEl.textContent = `Step 1 of ${steps.length}`;
    route.classList.remove('is-travelling');

    steps.forEach((step, i) => {
      step.classList.remove('is-active', 'is-complete');
      step.classList.toggle('is-waiting', i !== 0);
      setCardText(step, 'Waiting');
    });

    nodes.forEach((node, i) => {
      node.classList.remove('is-complete');
      node.classList.toggle('is-current', i === 0);
    });
  };

  const travelToCheckpoint = async (nextIndex) => {
    if (!running || !visible || finished) return;

    statusEl.textContent = 'Moving order to the next checkpoint...';
    stepLabelEl.textContent = `Moving to step ${nextIndex + 1} of ${steps.length}`;

    nodes.forEach(node => node.classList.remove('is-current'));
    route.classList.remove('is-travelling');
    await wait(0);
    if (!running || !visible || finished) return;
    route.classList.add('is-travelling');
    flow.style.setProperty('--pc-route', `${checkpointPercent(nextIndex)}%`);

    await wait(630);
    if (!running || !visible || finished) return;

    route.classList.remove('is-travelling');
    setCheckpointState(nextIndex);
    stepLabelEl.textContent = `Step ${nextIndex + 1} of ${steps.length}`;
  };

  const finishJourney = () => {
    finished = true;
    running = false;
    clearTimers();
    route.classList.remove('is-travelling');

    nodes.forEach(node => {
      node.classList.remove('is-current');
      node.classList.add('is-complete');
    });

    flow.style.setProperty('--pc-route', '100%');
    percentEl.textContent = '100';
    currentPercent = 100;
    statusEl.textContent = 'Order completed successfully';
    stepLabelEl.textContent = '6 of 6 steps complete';

    shell.classList.add('is-finished');
    celebration.setAttribute('aria-hidden', 'false');
    fireConfetti();
  };

  const processStep = async (index) => {
    if (!running || !visible || finished) return;

    const step = steps[index];

    step.classList.remove('is-waiting');
    step.classList.add('is-active');
    statusEl.textContent = stepMessages[index];
    stepLabelEl.textContent = `Step ${index + 1} of ${steps.length}`;
    setCardText(step, 'Processing');

    await wait(550);
    if (!running || !visible || finished) return;

    step.classList.remove('is-active');
    step.classList.add('is-complete');
    setCardText(step, 'Complete');
    statusEl.textContent = completeMessages[index];

    await wait(90);
    if (!running || !visible || finished) return;

    const targetPercent = completedPercent(index);
    await animatePercent(currentPercent, targetPercent, 280);
    currentPercent = targetPercent;

    await wait(260);
    if (!running || !visible || finished) return;

    if (index < steps.length - 1) {
      const next = index + 1;
      await travelToCheckpoint(next);
      if (!running || !visible || finished) return;
      await wait(80);
      await processStep(next);
    } else {
      finishJourney();
    }
  };

  const start = () => {
    if (running || finished) return;

    running = true;
    reset();

    if (reduceMotion.matches) {
      steps.forEach(step => {
        step.classList.remove('is-waiting');
        step.classList.add('is-complete');
        setCardText(step, 'Complete');
      });
      finishJourney();
      return;
    }

    wait(280).then(() => {
      if (running && visible && !finished) processStep(0);
    });
  };

  const stop = () => {
    if (finished) return;
    running = false;
    clearTimers();
    route.classList.remove('is-travelling');
  };

  const restart = () => {
    running = false;
    finished = false;
    reset();

    if (!visible) return;

    running = true;
    wait(180).then(() => {
      if (running && visible && !finished) processStep(0);
    });
  };

  restartBtn.addEventListener('click', restart);

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      visible = entry.isIntersecting && entry.intersectionRatio > 0.22;

      if (visible) {
        if (!running && !finished) start();
      } else {
        stop();
      }
    });
  }, { threshold:[0,.22,.5] });

  observer.observe(flow);

  reduceMotion.addEventListener?.('change', () => {
    running = false;
    finished = false;
    reset();
    if (visible) start();
  });
})();
</script>
