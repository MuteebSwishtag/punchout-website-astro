<script>
(() => {
  const stages = document.querySelectorAll('.open-integration .open-system-flow');
  if (!stages.length) return;

  const ns = 'http://www.w3.org/2000/svg';

  const drawStage = (stage) => {
    const svg = stage.querySelector('.hero-connectors');
    const hub = stage.querySelector('.open-hub');
    if (!svg || !hub) return;

    const box = stage.getBoundingClientRect();
    if (box.width < 1 || box.height < 1) {
      svg.replaceChildren();
      return;
    }

    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

    const hubBox = hub.getBoundingClientRect();
    const cx = hubBox.left - box.left + hubBox.width / 2;
    const cy = hubBox.top - box.top + hubBox.height / 2;
    const radius = Math.min(hubBox.width, hubBox.height) / 2;
    const vertical = getComputedStyle(stage).display === 'flex';
    const routes = [];

    stage.querySelectorAll('.open-procurement .open-system').forEach((card, index) => {
      const cardBox = card.getBoundingClientRect();
      const offset = (index - 1) * radius * .48;

      if (vertical) {
        const x1 = cardBox.left - box.left + cardBox.width / 2;
        const y1 = cardBox.bottom - box.top;
        const x2 = cx + offset;
        const y2 = cy - Math.sqrt(Math.max(0, radius * radius - offset * offset));
        routes.push([x1, y1, x2, y2]);
      } else {
        const y1 = cardBox.top - box.top + cardBox.height / 2;
        const y2 = cy + offset;
        const x1 = cardBox.right - box.left;
        const x2 = cx - Math.sqrt(Math.max(0, radius * radius - offset * offset));
        routes.push([x1, y1, x2, y2]);
      }
    });

    stage.querySelectorAll('.open-commerce .open-system').forEach((card, index) => {
      const cardBox = card.getBoundingClientRect();
      const offset = (index - 1) * radius * .48;

      if (vertical) {
        const x1 = cx + offset;
        const y1 = cy + Math.sqrt(Math.max(0, radius * radius - offset * offset));
        const x2 = cardBox.left - box.left + cardBox.width / 2;
        const y2 = cardBox.top - box.top;
        routes.push([x1, y1, x2, y2]);
      } else {
        const x1 = cx + Math.sqrt(Math.max(0, radius * radius - offset * offset));
        const y1 = cy + offset;
        const x2 = cardBox.left - box.left;
        const y2 = cardBox.top - box.top + cardBox.height / 2;
        routes.push([x1, y1, x2, y2]);
      }
    });

    svg.replaceChildren();

    routes.forEach(([x1, y1, x2, y2]) => {
      const path = document.createElementNS(ns, 'path');
      if (vertical) {
        const bend = Math.max(14, Math.abs(y2 - y1) * .5);
        path.setAttribute('d', `M ${x1} ${y1} C ${x1} ${y1 + bend}, ${x2} ${y2 - bend}, ${x2} ${y2}`);
      } else {
        const bend = Math.max(14, Math.abs(x2 - x1) * .52);
        path.setAttribute('d', `M ${x1} ${y1} C ${x1 + bend} ${y1}, ${x2 - bend} ${y2}, ${x2} ${y2}`);
      }
      svg.append(path);

      [[x1, y1], [x2, y2]].forEach(([x, y]) => {
        const dot = document.createElementNS(ns, 'circle');
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(y));
        dot.setAttribute('r', '4.5');
        svg.append(dot);
      });
    });
  };

  const drawAll = () => stages.forEach(drawStage);

  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(drawAll);
    stages.forEach((stage) => observer.observe(stage));
  }

  window.addEventListener('resize', drawAll, { passive: true });
  document.fonts?.ready?.then(drawAll);
  stages.forEach((stage) => {
    stage.querySelectorAll('img').forEach((img) => {
      if (img.complete) return;
      img.addEventListener('load', drawAll, { once: true });
    });
  });
  drawAll();
})();
</script>

