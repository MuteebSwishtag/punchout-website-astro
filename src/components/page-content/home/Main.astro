---
<main>




<section class="pc-hero" aria-labelledby="pcHeroTitle">
  <div class="wrap pc-hero__grid">
    <div class="pc-hero__copy reveal">
      <span class="ey">PunchOut for growing suppliers</span>

      <h1 id="pcHeroTitle" style="font-size: 3.0rem !important; line-height: 1.2 !important;">
        Shopify PunchOut for B2B suppliers: connect Coupa, GEP SMART, Ivalua, JAGGAER ONE, Oracle Fusion Procurement and SAP Ariba buyers.
      </h1>

      <p class="pc-hero__belief">
        Growing suppliers deserve bigger opportunities.
      </p>

      <p class="lead">
        PunchOut Central helps you connect your Shopify store to enterprise procurement systems,
        so when a bigger customer asks for PunchOut, you can confidently say yes.
      </p>

      <div class="acts">
         <a class="btn pri" href="https://app.punchoutcentral.com/platform/register" target="_blank">Connect my first buyer <span aria-hidden="true">→</span></a>
        <a class="btn secbtn" href="#how">See how it works <span aria-hidden="true">↓</span></a>
      </div>

      <div class="pc-hero__journey" aria-label="How a PunchOut order moves from Shopify to procurement">
        <div class="pc-hero__journey-step">
          <span class="pc-hero__journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation"><use href="/assets/ui-icons.svg#home-journey-store" width="100%" height="100%"></use></svg>
          </span>
          <span><strong>1. Connect your</strong><small>Shopify store</small></span>
        </div>
        <span class="pc-hero__journey-arrow" aria-hidden="true">→</span>
        <div class="pc-hero__journey-step">
          <span class="pc-hero__journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation"><use href="/assets/ui-icons.svg#home-journey-cart" width="100%" height="100%"></use></svg>
          </span>
          <span><strong>2. Buyers shop through</strong><small>Coupa, Ariba and more</small></span>
        </div>
        <span class="pc-hero__journey-arrow" aria-hidden="true">→</span>
        <div class="pc-hero__journey-step">
          <span class="pc-hero__journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation"><use href="/assets/ui-icons.svg#home-journey-document" width="100%" height="100%"></use></svg>
          </span>
          <span><strong>3. Carts return to their</strong><small>purchasing system</small></span>
        </div>
      </div>

      <div class="pc-hero__proof pc-hero__proof--inline" aria-label="PunchOut Central commercial terms">
        <strong class="pc-hero__proof-price">From $500/month</strong>

        <span class="pc-hero__proof-separator" aria-hidden="true"></span>

        <span class="pc-hero__proof-item">
          <span class="pc-hero__proof-check" aria-hidden="true">✓</span>
          Cancel anytime
        </span>

        <span class="pc-hero__proof-separator" aria-hidden="true"></span>

        <span class="pc-hero__proof-item">
          <span class="pc-hero__proof-check" aria-hidden="true">✓</span>
          Free Integration
        </span>

        <span class="pc-hero__proof-separator" aria-hidden="true"></span>

        <span class="pc-hero__proof-item">
          <span class="pc-hero__proof-check" aria-hidden="true">✓</span>
          No transaction fees
        </span>
      </div>
    </div>

    <div class="pc-hero__visual reveal" aria-label="PunchOut Central gateway architecture">
      <div class="pc-gateway-map">
        <div class="pc-gateway-map__group pc-gateway-map__group--procurement">
          <div class="pc-logo-stack" id="pcProcurementLogos"></div>
        </div>

        <svg class="pc-gateway-map__connectors" aria-hidden="true" focusable="false"></svg>

        <div class="pc-gateway-map__center">
          <div class="pc-hub">
            <span class="pc-hub__ring pc-hub__ring--one"></span>
            <span class="pc-hub__ring pc-hub__ring--two"></span>
            <div class="pc-hub__core">
              <span class="pc-hub__kicker">Managed gateway</span>
              <strong>PunchOut<br>Central</strong>
              <small>cXML · OCI</small>
            </div>
          </div>
        </div>

        <div class="pc-gateway-map__group pc-gateway-map__group--commerce">
          <div class="pc-logo-stack" id="pcCommerceLogos"></div>
        </div>
      </div>
    </div>
  </div>
</section>





