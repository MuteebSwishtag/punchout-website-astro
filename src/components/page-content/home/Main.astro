<script is:inline>
(() => {
  const header = document.getElementById('hdr');
  const menuButton = document.getElementById('hamb');
  const mobileMenu = document.getElementById('mob');

  const updateHeader = () => {
    if (header) header.classList.toggle('sc', window.scrollY > 12);
  };

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  // Keep the sticky secondary navigation in sync with the CSS header heights.
  const syncNavigationStack = () => {
    document.documentElement.style.setProperty(
      '--pc-header-height',
      window.matchMedia('(max-width: 1080px)').matches ? '66px' : '90px'
    );
  };

  syncNavigationStack();
  window.addEventListener('resize', syncNavigationStack, { passive: true });
  window.addEventListener('load', syncNavigationStack, { once: true });

  // Coordinate mega menus with the secondary navigation so the subnav never
  // steals hover while the cursor travels from a primary trigger into a panel.
  const megaItems = [...document.querySelectorAll('.pc-mega')];

  const setMegaNavigationState = (open) => {
    document.body.classList.toggle('pc-mega-open', open);
  };

  megaItems.forEach((item) => {
    item.addEventListener('mouseenter', () => setMegaNavigationState(true));
    item.addEventListener('mouseleave', () => {
      setMegaNavigationState(false);
      item.classList.remove('is-open');
      item.querySelector('.pc-nav-split>button')?.setAttribute('aria-expanded', 'false');
    });

    item.addEventListener('focusin', () => setMegaNavigationState(true));
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget)) {
        setMegaNavigationState(false);
        item.classList.remove('is-open');
        item.querySelector('.pc-nav-split>button')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  const solutionsMenuButton = document.querySelector('.pc-nav-split>button');
  if (solutionsMenuButton) {
    const solutionsDrop = solutionsMenuButton.closest('.drop');
    solutionsMenuButton.addEventListener('click', (event) => {
      const open = solutionsDrop.classList.toggle('is-open');
      solutionsMenuButton.setAttribute('aria-expanded', String(open));
      event.stopPropagation();
    });
    document.addEventListener('click', (event) => {
      if (solutionsDrop.contains(event.target)) return;
      solutionsDrop.classList.remove('is-open');
      solutionsMenuButton.setAttribute('aria-expanded', 'false');
    });
  }

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const open = menuButton.classList.toggle('open');
      mobileMenu.classList.toggle('open', open);
      menuButton.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      window.requestAnimationFrame(syncNavigationStack);
    });

    mobileMenu.addEventListener('click', (event) => {
      if (!event.target.closest('a')) return;
      menuButton.classList.remove('open');
      mobileMenu.classList.remove('open');
      menuButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  }

  document.querySelectorAll('.fi').forEach((item) => {
    const question = item.querySelector('.fq');
    const answer = item.querySelector('.fa');
    if (!question || !answer) return;

    question.addEventListener('click', () => {
      item.classList.toggle('open');
    });
  });

  const revealItems = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('on');
        revealObserver.unobserve(entry.target);
      });
    }, { threshold: 0.12 });

    revealItems.forEach((element) => revealObserver.observe(element));
  } else {
    revealItems.forEach((element) => element.classList.add('on'));
  }

  const addBuyerButton = document.getElementById('add');
  if (addBuyerButton) {
    addBuyerButton.addEventListener('click', () => {
      addBuyerButton.textContent = 'Buyer setup opened ✓';
      addBuyerButton.style.background = 'var(--bs)';
      addBuyerButton.style.borderColor = 'rgba(15,91,85,.20)';
    });
  }

  // One source of truth for every brand logo used in the hero and integration builder.
  const procurementSystems = [
    { id:'coupa', name:'Coupa', logo:'/assets/logos/coupa.svg', visualScale:1.00 },
    { id:'jaggaer', name:'JAGGAER', logo:'/assets/logos/jaggaer.png', visualScale:0.82 },
    { id:'oracle', name:'Oracle Procurement Cloud', logo:'/assets/logos/oracle.svg', visualScale:0.86 },
    { id:'sap-ariba', name:'SAP Ariba', logo:'/assets/logos/sap-ariba.png', visualScale:0.95 },
    { id:'ivalua', name:'Ivalua', logo:'/assets/logos/ivalua-logo-vector.svg', visualScale:0.92 },
    { id:'gep', name:'GEP SMART', logo:'/assets/logos/GEP-Logo-SVG.svg', visualScale:0.86 }
  ];

  const commerceSystems = [
    { id:'shopify', name:'Shopify', logo:'/assets/logos/shopify.svg', status:'Ready', statusClass:'ready', visualScale:1.12 },
    { id:'bigcommerce', name:'BigCommerce', logo:'/assets/logos/bigcommerce.svg', status:'Coming soon', statusClass:'soon', visualScale:1.05 },
    { id:'magento', name:'Magento', logo:'/assets/logos/magento.svg', status:'Coming soon', statusClass:'soon', visualScale:1.03 }
  ];

  const allSystems = [...procurementSystems, ...commerceSystems];
  const systemIndex = new Map(allSystems.map((system) => [system.id, system]));

  const createBrandGraphic = (system, wrapperClass) => {
    const wrapper = document.createElement('span');
    wrapper.className = wrapperClass;
    wrapper.style.setProperty('--logo-scale', system.visualScale || 1);

    const image = document.createElement('img');
    image.src = system.logo;
    image.alt = system.name;
    image.decoding = 'async';
    image.loading = 'lazy';

    wrapper.append(image);
    return wrapper;
  };

  const renderHeroLogos = (containerId, systems) => {
    const container = document.getElementById(containerId);
    if (!container) return;

    const fragment = document.createDocumentFragment();

    systems.forEach((system) => {
      const node = document.createElement('div');
      node.className = 'pc-logo-node';
      node.style.setProperty('--logo-scale', system.visualScale || 1);

      if (system.statusClass === 'soon') node.classList.add('is-coming-soon');
      if (system.statusClass === 'ready') node.classList.add('is-ready');

      const image = document.createElement('img');
      image.className = 'pc-logo-node__logo';
      image.src = system.logo;
      image.alt = system.name;
      image.decoding = 'async';
      image.loading = 'eager';
      image.fetchPriority = 'auto';

      node.append(image);
      fragment.append(node);
    });

    container.replaceChildren(fragment);
  };

  renderHeroLogos('pcProcurementLogos', procurementSystems);
  renderHeroLogos('pcCommerceLogos', commerceSystems);

  // Secondary navigation / current-section indicator.
  const subnavLinks = [...document.querySelectorAll('[data-scrollspy]')];
  const subnavSections = subnavLinks.map((link) => document.getElementById(link.dataset.scrollspy)).filter(Boolean);
  const subnavScroll = document.querySelector('.pc-subnav__scroll');

  const keepActiveSubnavVisible = (link) => {
    if (!subnavScroll || !link) return;
    link.scrollIntoView({
      block: 'nearest',
      inline: 'nearest',
      behavior: (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        window.innerWidth <= 760
      ) ? 'auto' : 'smooth'
    });
  };

  const setActiveSubnav = (sectionId) => {
    subnavLinks.forEach((link) => {
      const active = link.dataset.scrollspy === sectionId;
      link.classList.toggle('is-active', active);

      if (active) {
        link.setAttribute('aria-current', 'true');
        keepActiveSubnavVisible(link);
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };
  let subnavFrame = 0;
  const updateSubnav = () => {
    subnavFrame = 0;
    document.body.classList.toggle('subnav-on', window.scrollY > 500);
  };
  window.addEventListener('scroll', () => { if (!subnavFrame) subnavFrame = window.requestAnimationFrame(updateSubnav); }, { passive:true });
  updateSubnav();

  if (subnavLinks.length && subnavSections.length && 'IntersectionObserver' in window) {
    const visibleSections = new Map();
    const subnavObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          visibleSections.set(entry.target.id, entry.boundingClientRect.top);
        } else {
          visibleSections.delete(entry.target.id);
        }
      });

      const active = [...visibleSections.entries()].sort((a, b) => Math.abs(a[1]) - Math.abs(b[1]))[0];
      if (active) setActiveSubnav(active[0]);
    }, {
      rootMargin: '-22% 0px -62% 0px',
      threshold: [0, .12, .5]
    });

    subnavSections.forEach((section) => subnavObserver.observe(section));
  } else if (subnavSections.length) {
    setActiveSubnav(subnavSections[0].id);
  }

  // Interactive integration builder:
  // supports multiple source and destination instances, including duplicates.
  const integrationLab = document.getElementById('pcIntegrationLab');
  const sourceDrop = document.getElementById('pcSourceDrop');
  const destinationDrop = document.getElementById('pcDestinationDrop');
  const sourceSelection = document.getElementById('pcSourceSelection');
  const destinationSelection = document.getElementById('pcDestinationSelection');
  const integrationSummary = document.getElementById('pcIntegrationSummary');
  const integrationReset = document.getElementById('pcIntegrationReset');

  const integrationState = {
    procurement: [],
    commerce: []
  };

  const createChoiceLogo = (system) => {
    const wrapper = document.createElement('span');
    wrapper.className = 'pc-brand-choice__logo';
    wrapper.style.setProperty('--logo-scale', system.visualScale || 1);

    const image = document.createElement('img');
    image.src = system.logo;
    image.alt = system.name;
    image.decoding = 'async';

    wrapper.append(image);
    return wrapper;
  };

  const renderIntegrationChoices = (containerId, systems, side) => {
    const container = document.getElementById(containerId);
    if (!container) return;

    const fragment = document.createDocumentFragment();

    systems.forEach((system) => {
      const choice = document.createElement('button');
      choice.type = 'button';
      choice.className = 'pc-brand-choice';
      choice.draggable = true;
      choice.dataset.side = side;
      choice.dataset.systemId = system.id;
      choice.style.setProperty('--logo-scale', system.visualScale || 1);
      choice.setAttribute('aria-label', `Add ${system.name} to the ${side} side`);

      if (system.statusClass === 'soon') {
        choice.classList.add('is-coming-soon');
      }

      choice.append(createChoiceLogo(system));

      // Tap/click adds one instance.
      choice.addEventListener('click', () => addIntegration(side, system.id));

      // Drag can add the same platform repeatedly to model multiple buyers/stores.
      choice.addEventListener('dragstart', (event) => {
        event.dataTransfer.effectAllowed = 'copy';
        event.dataTransfer.setData('text/plain', `${side}:${system.id}`);
      });

      fragment.append(choice);
    });

    container.replaceChildren(fragment);
  };

  const createSelectedLogo = (side, systemId, instanceIndex) => {
    const system = systemIndex.get(systemId);
    const selected = document.createElement('button');
    selected.type = 'button';
    selected.className = 'pc-drop-logo';
    selected.style.setProperty('--logo-scale', system.visualScale || 1);
    selected.setAttribute('aria-label', `Remove ${system.name}`);

    if (system.statusClass === 'soon') {
      selected.classList.add('is-coming-soon');
    }

    const image = document.createElement('img');
    image.src = system.logo;
    image.alt = system.name;
    image.decoding = 'async';
    image.loading = 'lazy';

    selected.append(image);
    selected.addEventListener('click', () => removeIntegration(side, instanceIndex));

    return selected;
  };

  const renderDropSelection = (side, container) => {
    if (!container) return;

    const items = integrationState[side];

    if (!items.length) {
      const empty = document.createElement('span');
      empty.className = 'pc-integration-drop__empty';
      empty.textContent = '＋';
      empty.setAttribute('aria-hidden', 'true');
      container.replaceChildren(empty);
      return;
    }

    const fragment = document.createDocumentFragment();

    items.forEach((systemId, index) => {
      fragment.append(createSelectedLogo(side, systemId, index));
    });

    container.replaceChildren(fragment);
  };

  const updateIntegrationFlow = () => {
    renderDropSelection('procurement', sourceSelection);
    renderDropSelection('commerce', destinationSelection);

    const hasSource = integrationState.procurement.length > 0;
    const hasDestination = integrationState.commerce.length > 0;
    const connected = hasSource && hasDestination;

    sourceDrop?.classList.toggle('has-selection', hasSource);
    destinationDrop?.classList.toggle('has-selection', hasDestination);
    integrationLab?.classList.toggle('is-connected', connected);

    if (!integrationSummary) return;

    if (!hasSource && !hasDestination) {
      integrationSummary.textContent = 'Add platforms to both sides to start the connection.';
    } else if (!hasSource) {
      integrationSummary.textContent = 'Now add one or more procurement connections.';
    } else if (!hasDestination) {
      integrationSummary.textContent = 'Now add one or more ecommerce stores.';
    } else {
      const sources = integrationState.procurement.length;
      const destinations = integrationState.commerce.length;
      integrationSummary.textContent =
        `${sources} procurement connection${sources === 1 ? '' : 's'} ↔ PunchOut Central ↔ ` +
        `${destinations} commerce destination${destinations === 1 ? '' : 's'}.`;
    }
  };

  const addIntegration = (side, systemId) => {
    if (!systemIndex.has(systemId)) return;

    // Keep the demo clean while still allowing many-to-many.
    if (integrationState[side].length >= 4) return;

    integrationState[side].push(systemId);
    updateIntegrationFlow();
  };

  const removeIntegration = (side, instanceIndex) => {
    integrationState[side].splice(instanceIndex, 1);
    updateIntegrationFlow();
  };

  const bindDropZone = (zone) => {
    if (!zone) return;

    zone.addEventListener('dragover', (event) => {
      event.preventDefault();
      event.dataTransfer.dropEffect = 'copy';
      zone.classList.add('is-dragover');
    });

    zone.addEventListener('dragleave', () => {
      zone.classList.remove('is-dragover');
    });

    zone.addEventListener('drop', (event) => {
      event.preventDefault();
      zone.classList.remove('is-dragover');

      const payload = event.dataTransfer.getData('text/plain');
      const [side, systemId] = payload.split(':');

      if (side !== zone.dataset.accept) return;
      addIntegration(side, systemId);
    });
  };

  renderIntegrationChoices('pcProcurementChoices', procurementSystems, 'procurement');
  renderIntegrationChoices('pcCommerceChoices', commerceSystems, 'commerce');

  bindDropZone(sourceDrop);
  bindDropZone(destinationDrop);

  integrationReset?.addEventListener('click', () => {
    integrationState.procurement = [];
    integrationState.commerce = [];
    updateIntegrationFlow();
  });

  updateIntegrationFlow();

})();
</script>


<script is:inline>
(() => {
  const flow = document.getElementById('pcOrderFlow');
  if (!flow) return;

  const shell = flow.closest('.pc-order-shell');
  const route = flow.querySelector('.pc-order-route');
  const steps = Array.from(flow.querySelectorAll('.pc-order-step'));
  const nodes = Array.from(flow.querySelectorAll('.pc-order-route__node'));
  const percentEl = document.getElementById('pcOrderPercent');
  const statusEl = document.getElementById('pcOrderStatus');
  const stepLabelEl = document.getElementById('pcOrderStepLabel');
  const restartBtn = document.getElementById('pcOrderRestart');
  const confetti = document.getElementById('pcOrderConfetti');
  const celebration = shell?.querySelector('.pc-order-celebration');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (
    !shell || !route || !steps.length || !percentEl || !statusEl ||
    !stepLabelEl || !restartBtn || !confetti || !celebration
  ) return;

  const stepMessages = [
    'Starting PunchOut session…',
    'Returning cart to procurement…',
    'Waiting for buyer approval…',
    'Receiving approved purchase order…',
    'Creating Shopify order…',
    'Generating invoice…'
  ];

  const completeMessages = [
    'PunchOut session started',
    'Cart returned successfully',
    'Buyer approval completed',
    'Purchase order received',
    'Shopify order created',
    'Invoice generated'
  ];

  let timers = [];
  let running = false;
  let visible = false;
  let finished = false;
  let currentPercent = 0;

  const wait = (ms) => new Promise(resolve => {
    const id = window.setTimeout(resolve, ms);
    timers.push(id);
  });

  const clearTimers = () => {
    timers.forEach(window.clearTimeout);
    timers = [];
  };

  const setCardText = (step, text) => {
    const el = step.querySelector('.pc-order-step__state-text');
    if (el) el.textContent = text;
  };

  const checkpointPercent = (index) => {
    const max = Math.max(steps.length - 1, 1);
    return (index / max) * 100;
  };

  const completedPercent = (index) => {
    return Math.round(((index + 1) / steps.length) * 100);
  };

  const animatePercent = (from, to, duration = 460) => {
    const startTime = performance.now();

    return new Promise(resolve => {
      const tick = (now) => {
        if (!running || !visible) return resolve();

        const p = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        const value = Math.round(from + (to - from) * eased);
        percentEl.textContent = String(value);

        if (p < 1) requestAnimationFrame(tick);
        else resolve();
      };

      requestAnimationFrame(tick);
    });
  };

  const setCheckpointState = (currentIndex) => {
    nodes.forEach((node, i) => {
      node.classList.toggle('is-current', i === currentIndex);
      node.classList.toggle('is-complete', i < currentIndex);
    });
  };

  const clearConfetti = () => {
    confetti.innerHTML = '';
  };

  const fireConfetti = () => {
    clearConfetti();
    if (reduceMotion.matches) return;

    const colors = ['#C2FF02', '#99FEED', '#D9D6FD', '#FFBD9B', '#202124', '#FFFFFF'];
    const pieces = 140;

    for (let i = 0; i < pieces; i++) {
      const piece = document.createElement('span');
      piece.className = 'pc-order-confetti__piece';

      /* Spread pieces across the full upper section instead of one row. */
      const x = 2 + Math.random() * 96;
      const y = -8 + Math.random() * 36;

      /* Varied shapes and sizes make the burst feel more natural. */
      const w = 4 + Math.random() * 7;
      const h = Math.random() > .35 ? 8 + Math.random() * 12 : w;
      const radius = Math.random() > .65 ? '50%' : `${Math.random() * 3}px`;

      /* More lateral movement creates a wide celebration. */
      const drift = -180 + Math.random() * 360;
      const fall = 360 + Math.random() * 280;
      const startRot = -90 + Math.random() * 180;
      const rot = 360 + Math.random() * 900;
      const scale = .72 + Math.random() * .72;

      /* Stagger several mini-bursts while keeping total celebration ~3 sec. */
      const duration = 2200 + Math.random() * 650;
      const delay = Math.random() * 180;

      const color = colors[Math.floor(Math.random() * colors.length)];

      piece.style.setProperty('--x', `${x}%`);
      piece.style.setProperty('--y', `${y}%`);
      piece.style.setProperty('--w', `${w}px`);
      piece.style.setProperty('--h', `${h}px`);
      piece.style.setProperty('--radius', radius);
      piece.style.setProperty('--drift', `${drift}px`);
      piece.style.setProperty('--fall', `${fall}px`);
      piece.style.setProperty('--start-rot', `${startRot}deg`);
      piece.style.setProperty('--rot', `${rot}deg`);
      piece.style.setProperty('--scale', scale.toFixed(2));
      piece.style.setProperty('--d', `${duration}ms`);
      piece.style.setProperty('--delay', `${delay}ms`);
      piece.style.setProperty('--c', color);

      confetti.appendChild(piece);
    }

    window.setTimeout(clearConfetti, 3050);
  };

  const reset = () => {
    clearTimers();
    clearConfetti();

    finished = false;
    currentPercent = 0;
    shell.classList.remove('is-finished');
    celebration.setAttribute('aria-hidden', 'true');

    percentEl.textContent = '0';
    flow.style.setProperty('--pc-route', '0%');
    statusEl.textContent = stepMessages[0];
    stepLabelEl.textContent = `Step 1 of ${steps.length}`;
    route.classList.remove('is-travelling');

    steps.forEach((step, i) => {
      step.classList.remove('is-active', 'is-complete');
      step.classList.toggle('is-waiting', i !== 0);
      setCardText(step, 'Waiting');
    });

    nodes.forEach((node, i) => {
      node.classList.remove('is-complete');
      node.classList.toggle('is-current', i === 0);
    });
  };

  const travelToCheckpoint = async (nextIndex) => {
    if (!running || !visible || finished) return;

    statusEl.textContent = 'Moving order to the next checkpoint…';
    stepLabelEl.textContent = `Moving to step ${nextIndex + 1} of ${steps.length}`;

    nodes.forEach(node => node.classList.remove('is-current'));
    route.classList.remove('is-travelling');
    await wait(0);
    if (!running || !visible || finished) return;
    route.classList.add('is-travelling');

    flow.style.setProperty(
      '--pc-route',
      `${checkpointPercent(nextIndex)}%`
    );

    await wait(630);
    if (!running || !visible || finished) return;

    route.classList.remove('is-travelling');
    setCheckpointState(nextIndex);
    stepLabelEl.textContent = `Step ${nextIndex + 1} of ${steps.length}`;
  };

  const finishJourney = () => {
    finished = true;
    running = false;
    clearTimers();
    route.classList.remove('is-travelling');

    nodes.forEach(node => {
      node.classList.remove('is-current');
      node.classList.add('is-complete');
    });

    flow.style.setProperty('--pc-route', '100%');
    percentEl.textContent = '100';
    currentPercent = 100;
    statusEl.textContent = 'Order completed successfully';
    stepLabelEl.textContent = '6 of 6 steps complete';

    shell.classList.add('is-finished');
    celebration.setAttribute('aria-hidden', 'false');
    fireConfetti();
  };

  const processStep = async (index) => {
    if (!running || !visible || finished) return;

    const step = steps[index];

    step.classList.remove('is-waiting');
    step.classList.add('is-active');
    statusEl.textContent = stepMessages[index];
    stepLabelEl.textContent = `Step ${index + 1} of ${steps.length}`;
    setCardText(step, 'Processing');

    await wait(550);
    if (!running || !visible || finished) return;

    step.classList.remove('is-active');
    step.classList.add('is-complete');
    setCardText(step, 'Complete');
    statusEl.textContent = completeMessages[index];

    await wait(90);
    if (!running || !visible || finished) return;

    const targetPercent = completedPercent(index);
    await animatePercent(currentPercent, targetPercent, 280);
    currentPercent = targetPercent;

    await wait(260);
    if (!running || !visible || finished) return;

    if (index < steps.length - 1) {
      const next = index + 1;

      await travelToCheckpoint(next);
      if (!running || !visible || finished) return;

      await wait(80);
      await processStep(next);
    } else {
      finishJourney();
    }
  };

  const start = () => {
    if (running || finished) return;

    running = true;
    reset();

    if (reduceMotion.matches) {
      steps.forEach(step => {
        step.classList.remove('is-waiting');
        step.classList.add('is-complete');
        setCardText(step, 'Complete');
      });
      finishJourney();
      return;
    }

    wait(280).then(() => {
      if (running && visible && !finished) processStep(0);
    });
  };

  const stop = () => {
    if (finished) return;
    running = false;
    clearTimers();
    route.classList.remove('is-travelling');
  };

  const restart = () => {
    running = false;
    finished = false;
    reset();

    if (!visible) return;

    running = true;
    wait(180).then(() => {
      if (running && visible && !finished) processStep(0);
    });
  };

  restartBtn.addEventListener('click', restart);

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      visible = entry.isIntersecting && entry.intersectionRatio > 0.22;

      if (visible) {
        if (!running && !finished) start();
      } else {
        stop();
      }
    });
  }, { threshold:[0,.22,.5] });

  observer.observe(flow);

  reduceMotion.addEventListener?.('change', () => {
    running = false;
    finished = false;
    reset();
    if (visible) start();
  });
})();
</script>
