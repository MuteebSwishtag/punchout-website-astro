---
const formEndpoint = import.meta.env.PUBLIC_BOOK_DEMO_ENDPOINT ?? '/api/book-demo.php';
const formToken = import.meta.env.PUBLIC_BOOK_DEMO_TOKEN ?? '';
---
<main>
  <section class="page-hero page-hero--mint" id="overview">
    <div class="wrap form-shell book-demo-shell">
      <div class="page-hero__copy reveal">
        <span class="ey">Book a demo</span>
        <h1>Show us the buyers and store you need to connect.</h1>
        <p class="lead">Tell us which procurement systems your buyers use and whether they will share one Shopify store. Request a preferred demo time so we can discuss catalog access, connections and the order flow.</p>
        <div class="metrics-row book-demo-intro-grid">
          <article class="metric"><strong>One Shopify store</strong><span>Serve multiple buyers with buyer-specific catalog access.</span></article>
          <article class="metric"><strong>Clear next step</strong><span>Share your buyer requirements and a preferred time to talk with our team.</span></article>
        </div>
      </div>

      <div class="form-card book-demo-card reveal" id="bookingFlow">
        <form id="demoForm" action={formEndpoint} method="post" data-form-token={formToken} novalidate>
          <input type="hidden" name="form_source" value="book-demo">
          <input type="hidden" id="selectedDate" name="selectedDate">
          <input type="hidden" id="selectedDateISO" name="selectedDateISO">
          <input type="hidden" id="selectedTime" name="selectedTime">
          <input type="hidden" id="selectedTimeLabel" name="selectedTimeLabel">
          <input type="hidden" id="timezone" name="timezone">
          <input type="text" id="nickname" name="nickname" class="book-demo-hp" tabindex="-1" autocomplete="off" aria-hidden="true">

          <div class="book-demo-stepper" aria-label="Demo request steps">
            <div class="book-demo-step active" data-step-indicator="1">
              <span>1</span>
              <strong>Your details</strong>
            </div>
            <div class="book-demo-step" data-step-indicator="2">
              <span>2</span>
              <strong>Pick a time</strong>
            </div>
          </div>

          <section class="book-demo-panel active" data-step="1" aria-labelledby="demoStepOneTitle">
            <div class="book-demo-panel__head">
              <h2 id="demoStepOneTitle">Tell us about your buyer setup.</h2>
              <p>Share the store and procurement requirements so the conversation can focus on your connection.</p>
            </div>

            <div class="form-grid">
              <div class="form-field">
                <label for="name">Name</label>
                <input id="name" name="name" required autocomplete="name">
              </div>
              <div class="form-field">
                <label for="email">Work email</label>
                <input id="email" name="email" type="email" required autocomplete="email">
              </div>
              <div class="form-field">
                <label for="company">Company</label>
                <input id="company" name="company" required autocomplete="organization">
              </div>
              <div class="form-field">
                <label for="website">Website <span>optional</span></label>
                <input id="website" name="website" inputmode="url" autocomplete="url" placeholder="yourstore.com">
              </div>
              <div class="form-field">
                <label for="platform">Buyer procurement system</label>
                <select id="platform" name="platform" required>
                  <option>Not sure yet</option>
                  <option>Coupa</option>
                  <option>SAP Ariba</option>
                  <option>JAGGAER</option>
                  <option>Oracle Procurement</option>
                  <option>Workday</option>
                  <option>Ivalua</option>
                  <option>GEP SMART</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="form-field">
                <label for="storePlatform">Commerce platform</label>
                <select id="storePlatform" name="storePlatform">
                  <option>Shopify</option>
                  <option>Shopify Plus</option>
                  <option value="BigCommerce">BigCommerce (coming soon — join waitlist)</option>
                  <option value="Magento / Adobe Commerce">Magento / Adobe Commerce (coming soon — join waitlist)</option>
                  <option value="Custom store">Custom store (coming soon — join waitlist)</option>
                  <option>Not sure yet</option>
                </select>
              </div>
              <div class="form-field form-field--full">
                <label for="message">What did the buyer ask for? <span>optional</span></label>
                <textarea id="message" name="message" placeholder="Example: Our customer uses Coupa and asked if our Shopify store supports PunchOut."></textarea>
              </div>
            </div>

            <p class="book-demo-error" data-error="1" role="alert"></p>
            <div class="book-demo-actions">
              <span class="fine-print">You’ll choose a preferred time next.</span>
              <button class="btn pri" type="button" data-next>Continue to times &rarr;</button>
            </div>
          </section>

          <section class="book-demo-panel" data-step="2" aria-labelledby="demoStepTwoTitle">
            <div class="book-demo-panel__head">
              <h2 id="demoStepTwoTitle">Choose a preferred time.</h2>
              <p>Choose a preferred date and time. Our team will follow up to confirm availability.</p>
            </div>

            <div class="book-demo-picker">
              <div class="book-demo-picker__box">
                <h3>Date</h3>
                <div class="book-demo-date-list" id="dateList" aria-label="Preferred demo dates"></div>
              </div>
              <div class="book-demo-picker__box">
                <h3>Time</h3>
                <p class="book-demo-selected-date" id="selectedDatePill" hidden><span></span></p>
                <div class="book-demo-time-list" id="timeList" aria-label="Preferred demo times"></div>
                <p class="book-demo-timezone">Times are shown in <strong id="timezoneText">US Eastern Time</strong>.</p>
              </div>
            </div>

            <div class="book-demo-summary" id="bookingSummary" aria-live="polite"></div>
            <p class="book-demo-error" data-error="2" role="alert"></p>
            <div class="book-demo-actions">
              <button class="btn secbtn" type="button" data-back>Back</button>
              <button class="btn pri" id="submitBtn" type="submit">Send demo request &rarr;</button>
            </div>
          </section>
        </form>

        <section class="book-demo-success" id="successState" aria-live="polite">
          <span class="ey">Demo requested</span>
          <h2 id="successTitle">Your demo request was received.</h2>
          <p id="successMessage">We will follow up about the requested time.</p>
          <div class="book-demo-success__grid">
            <div><small>Requested date</small><strong id="successDate"></strong></div>
            <div><small>Requested time</small><strong id="successTime"></strong></div>
            <div><small>Company</small><strong id="successCompany"></strong></div>
            <div><small>Platform</small><strong id="successPlatform"></strong></div>
          </div>
          <p class="book-demo-zoom-link" id="successZoom" hidden><a href="#" target="_blank" rel="noreferrer">Join Zoom meeting</a></p>
          <button class="btn secbtn" id="bookAnotherBtn" type="button">Send another request</button>
        </section>

      </div>
    </div>
  </section>
  <section class="sec soft" aria-label="Plan your demo">
    <div class="wrap">
      <div class="section-head reveal"><span class="ey">Prepare for the conversation</span><h2>Know the store, buyers and connection count.</h2><p class="lead">One Shopify store can serve multiple enterprise buyers. Each new buyer or additional store counts as a connection.</p></div>
      <div class="related-grid">
        <a class="related-card reveal" href="/solutions/one-store-multiple-buyers/"><span>Connection model</span><h3>One store, multiple buyers</h3><p>See how buyer-specific catalog access works.</p><b>Explore &rarr;</b></a>
        <a class="related-card reveal" href="/integrations/procurement-systems/"><span>Buyer side</span><h3>Procurement systems</h3><p>Review the buyer environment and protocol questions.</p><b>Explore &rarr;</b></a>
        <a class="related-card reveal" href="/pricing/"><span>Plans</span><h3>PunchOut pricing</h3><p>Compare the Starter, Growth and Scale connection allowances.</p><b>Explore &rarr;</b></a>
      </div>
    </div>
  </section>
</main>

<script is:inline>
(() => {
  const form = document.getElementById('demoForm');
  if (!form) return;

  const panels = [...document.querySelectorAll('.book-demo-panel')];
  const indicators = [...document.querySelectorAll('[data-step-indicator]')];
  const nextBtn = form.querySelector('[data-next]');
  const backBtn = form.querySelector('[data-back]');
  const dateList = document.getElementById('dateList');
  const timeList = document.getElementById('timeList');
  const timezoneText = document.getElementById('timezoneText');
  const selectedDatePill = document.getElementById('selectedDatePill');
  const bookingSummary = document.getElementById('bookingSummary');
  const submitBtn = document.getElementById('submitBtn');
  const successState = document.getElementById('successState');
  const bookAnotherBtn = document.getElementById('bookAnotherBtn');
  const hiddenDate = document.getElementById('selectedDate');
  const hiddenDateISO = document.getElementById('selectedDateISO');
  const hiddenTime = document.getElementById('selectedTime');
  const hiddenTimeLabel = document.getElementById('selectedTimeLabel');
  const hiddenTimezone = document.getElementById('timezone');
  const formLoadedAt = Date.now().toString();
  const bookingTimezone = 'America/New_York';

  const state = {
    step: 1,
    selectedDate: '',
    selectedDateISO: '',
    selectedTime: '',
    selectedTimeLabel: '',
    timezone: bookingTimezone,
  };

  const slotTimes = ['09:00', '10:30', '12:00', '13:30', '15:00'];
  const dateOptions = [];
  const today = getTodayInBookingTimezone();

  timezoneText.textContent = 'US Eastern Time';
  hiddenTimezone.value = state.timezone;

  for (let i = 1; dateOptions.length < 10 && i < 21; i += 1) {
    const date = new Date(today);
    date.setDate(today.getDate() + i);
    if (date.getDay() !== 0 && date.getDay() !== 6) dateOptions.push(date);
  }

  function getTodayInBookingTimezone() {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: bookingTimezone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date()).reduce((memo, part) => {
      memo[part.type] = part.value;
      return memo;
    }, {});
    return new Date(`${parts.year}-${parts.month}-${parts.day}T12:00:00`);
  }

  function setStep(step) {
    state.step = step;
    panels.forEach(panel => panel.classList.toggle('active', Number(panel.dataset.step) === step));
    indicators.forEach(indicator => {
      const indicatorStep = Number(indicator.dataset.stepIndicator);
      indicator.classList.toggle('active', indicatorStep === step);
      indicator.classList.toggle('done', indicatorStep < step);
    });
    clearError(step);
  }

  function clearError(step) {
    const error = document.querySelector(`[data-error="${step}"]`);
    if (!error) return;
    error.textContent = '';
    error.classList.remove('show');
  }

  function showError(step, message) {
    const error = document.querySelector(`[data-error="${step}"]`);
    if (!error) return;
    error.textContent = message;
    error.classList.add('show');
  }

  function normalizeWebsite(value) {
    const trimmed = value.trim();
    if (!trimmed) return '';
    if (/\s/.test(trimmed)) return '';

    try {
      const url = new URL(/^[a-z][a-z\d+.-]*:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`);
      if (!['http:', 'https:'].includes(url.protocol) || !url.hostname.includes('.')) return '';
      return url.href;
    } catch {
      return '';
    }
  }

  function validateStep(step) {
    if (step === 1) {
      const requiredFields = [
        ['name', 'Please enter your name before continuing.'],
        ['email', 'Please enter your work email before continuing.'],
        ['company', 'Please enter your company before continuing.'],
      ];

      for (const [id, message] of requiredFields) {
        const field = document.getElementById(id);
        if (!field.value.trim()) {
          field.focus();
          showError(1, message);
          return false;
        }
      }

      const email = document.getElementById('email');
      if (!email.checkValidity()) {
        email.focus();
        showError(1, 'Please enter a valid work email address.');
        return false;
      }

      const website = document.getElementById('website');
      if (website.value.trim()) {
        const normalized = normalizeWebsite(website.value);
        if (!normalized) {
          website.focus();
          showError(1, 'If you add a website, use a valid domain like example.com.');
          return false;
        }
        website.value = normalized;
      }

      clearError(1);
      return true;
    }

    if (step === 2) {
      if (!state.selectedDateISO) {
        showError(2, 'Please choose a preferred demo date.');
        dateList.querySelector('button')?.focus();
        return false;
      }
      if (!state.selectedTime) {
        showError(2, 'Please choose a preferred demo time.');
        timeList.querySelector('button')?.focus();
        return false;
      }
      clearError(2);
      return true;
    }

    return true;
  }

  function formatDateLong(date) {
    return new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric' }).format(date);
  }

  function formatDateParts(date) {
    return {
      day: new Intl.DateTimeFormat('en-US', { weekday: 'short' }).format(date),
      date: new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(date),
    };
  }

  function formatLocalDateISO(date) {
    return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  }

  function formatTimeLabel(time) {
    const [hour, minute] = time.split(':').map(Number);
    const suffix = hour >= 12 ? 'PM' : 'AM';
    const displayHour = hour % 12 || 12;
    return `${displayHour}:${String(minute).padStart(2, '0')} ${suffix}`;
  }

  function updateHiddenFields() {
    hiddenDate.value = state.selectedDate;
    hiddenDateISO.value = state.selectedDateISO;
    hiddenTime.value = state.selectedTime;
    hiddenTimeLabel.value = state.selectedTimeLabel;
    hiddenTimezone.value = state.timezone;
  }

  function updateSummary() {
    updateHiddenFields();
    if (state.selectedDate && state.selectedTimeLabel) {
      bookingSummary.classList.add('show');
      bookingSummary.innerHTML = `<strong>Preferred time</strong>${state.selectedDate} at ${state.selectedTimeLabel} - US Eastern Time`;
    } else if (state.selectedDate) {
      bookingSummary.classList.add('show');
      bookingSummary.innerHTML = `<strong>Date selected</strong>${state.selectedDate}. Choose a time to complete your request.`;
    } else {
      bookingSummary.classList.remove('show');
      bookingSummary.textContent = '';
    }
  }

  function renderTimes() {
    state.selectedTime = '';
    state.selectedTimeLabel = '';
    timeList.innerHTML = '';

    slotTimes.forEach(time => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'book-demo-time-btn';
      btn.setAttribute('aria-pressed', 'false');
      btn.textContent = formatTimeLabel(time);
      btn.addEventListener('click', () => {
        [...timeList.children].forEach(item => {
          item.classList.remove('active');
          item.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        state.selectedTime = time;
        state.selectedTimeLabel = btn.textContent;
        updateSummary();
      });
      timeList.appendChild(btn);
    });

    updateSummary();
  }

  function selectDate(date, btn) {
    state.selectedDate = formatDateLong(date);
    state.selectedDateISO = formatLocalDateISO(date);
    [...dateList.children].forEach(item => {
      item.classList.remove('active');
      item.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-pressed', 'true');
    selectedDatePill.hidden = false;
    selectedDatePill.querySelector('span').textContent = state.selectedDate;
    renderTimes();
  }

  function renderDates() {
    state.selectedDate = '';
    state.selectedDateISO = '';
    state.selectedTime = '';
    state.selectedTimeLabel = '';
    selectedDatePill.hidden = true;
    dateList.innerHTML = '';
    timeList.innerHTML = '';
    updateSummary();
    dateOptions.forEach(date => {
      const parts = formatDateParts(date);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'book-demo-date-btn';
      btn.setAttribute('aria-pressed', 'false');
      btn.innerHTML = `<small>${parts.day}</small><strong>${parts.date}</strong>`;
      btn.addEventListener('click', () => selectDate(date, btn));
      dateList.appendChild(btn);
    });
  }

  function setSubmitting(isSubmitting) {
    submitBtn.disabled = isSubmitting;
    submitBtn.textContent = isSubmitting ? 'Sending...' : 'Send demo request →';
  }

  async function submitPayload(payload) {
    const headers = { Accept: 'application/json', 'Content-Type': 'application/json' };
    const token = form.dataset.formToken || '';
    if (token) headers['X-Book-Demo-Token'] = token;

    const response = await fetch(form.action, {
      method: 'POST',
      headers,
      body: JSON.stringify(payload),
    });
    const contentType = response.headers.get('content-type') || '';
    if (!contentType.includes('application/json')) {
      throw new Error('The form endpoint is not returning JSON yet. Check the endpoint URL and PHP hosting setup.');
    }
    const result = await response.json();
    if (!response.ok || !result.ok) {
      throw new Error(result.message || 'We could not send your request right now.');
    }
    return result;
  }

  nextBtn.addEventListener('click', () => {
    if (validateStep(1)) setStep(2);
  });

  backBtn.addEventListener('click', () => setStep(1));

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!validateStep(2)) return;
    if (document.getElementById('nickname').value.trim()) return;

    const payload = Object.fromEntries(new FormData(form).entries());
    payload.page = window.location.href;
    payload.referrer = document.referrer;
    payload.form_loaded_at = formLoadedAt;

    try {
      setSubmitting(true);
      const result = await submitPayload(payload);

      const meetingCreated = Boolean(result.zoom?.id);
      const teamNotified = Boolean(result.email?.sent);
      const requestRecorded = Boolean(result.recorded || result.submission_id);
      if (!meetingCreated && !teamNotified && !requestRecorded) {
        throw new Error('The request was not confirmed. Please try again.');
      }
      document.getElementById('successTitle').textContent = meetingCreated
        ? 'A Zoom meeting was created.'
        : teamNotified ? 'Your demo request was sent.' : 'Your demo request was recorded.';
      document.getElementById('successMessage').textContent = meetingCreated
        ? 'A Zoom meeting was created for the selected time. We will follow up with any additional details.'
        : teamNotified ? 'The PunchOut Central team was notified by email. We will follow up to confirm availability.'
        : 'Your request was saved for the PunchOut Central team. We will follow up to confirm availability.';
      document.getElementById('successDate').textContent = state.selectedDate;
      document.getElementById('successTime').textContent = `${state.selectedTimeLabel} - US Eastern Time`;
      document.getElementById('successCompany').textContent = payload.company;
      document.getElementById('successPlatform').textContent = payload.platform;

      const zoomLink = result.zoom?.join_url || result.zoom?.joinUrl || '';
      const zoomWrap = document.getElementById('successZoom');
      if (meetingCreated && zoomLink) {
        zoomWrap.hidden = false;
        zoomWrap.querySelector('a').href = zoomLink;
      } else {
        zoomWrap.hidden = true;
      }

      form.hidden = true;
      successState.classList.add('show');
      successState.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (error) {
      showError(2, error.message || 'We could not send your request right now. Please try again.');
    } finally {
      setSubmitting(false);
    }
  });

  bookAnotherBtn.addEventListener('click', () => {
    form.reset();
    form.hidden = false;
    successState.classList.remove('show');
    renderDates();
    setStep(1);
  });

  renderDates();
})();
</script>

<style>
  .book-demo-shell {
    grid-template-columns: minmax(300px, .82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 5vw, 72px);
  }
  .book-demo-shell .page-hero__copy { max-width: 580px; }
  .book-demo-shell .page-hero__copy h1 {
    max-width: 600px;
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: .95;
  }
  .book-demo-card,
  .book-demo-card form,
  .book-demo-picker__box { min-width: 0; }
  .book-demo-intro-grid {
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 30px;
  }
  .book-demo-intro-grid .metric { padding: 18px 20px; }
  .book-demo-intro-grid .metric strong {
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    line-height: 1.05;
  }
  .book-demo-intro-grid .metric span { max-width: none; margin-top: 8px; }

  @media (max-width: 1080px) {
    .book-demo-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .book-demo-shell .page-hero__copy { max-width: 760px; }
  }

  @media (max-width: 760px) {
    .book-demo-shell { gap: 28px; }
    .book-demo-shell .page-hero__copy h1 {
      max-width: 520px;
      font-size: clamp(2.75rem, 11vw, 4rem);
      line-height: .98;
    }
    .book-demo-card { padding: 20px; border-radius: 22px; }
  }

  @media (max-width: 600px) {
    #bookingFlow .book-demo-date-list,
    #bookingFlow .book-demo-time-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 380px) {
    .book-demo-card { padding: 16px; }
    #bookingFlow .book-demo-date-list,
    #bookingFlow .book-demo-time-list { grid-template-columns: 1fr; }
  }
</style>
