---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faMagento, faShopify } from '@fortawesome/free-brands-svg-icons';
import { faStore } from '@fortawesome/free-solid-svg-icons';

const formEndpoint = import.meta.env.PUBLIC_PRICING_FORM_ENDPOINT || '/api/book-demo.php';
const formToken = import.meta.env.PUBLIC_PRICING_FORM_TOKEN || import.meta.env.PUBLIC_BOOK_DEMO_TOKEN || '';
const shopifyConnectUrl = 'https://app.punchoutcentral.com';

const shopifyIcon = icon(faShopify).html.join('');
const magentoIcon = icon(faMagento).html.join('');
const otherIcon = icon(faStore).html.join('');
---
<main>

<section class="page-hero page-hero--mint" id="overview">
  <div class="wrap page-hero__grid">
    <div class="page-hero__copy reveal">
      <span class="ey">PunchOut pricing</span><h1>Pricing that grows with your buyer connections.</h1>
      <p class="lead">Starter is $500/month for one connection. Add buyers as you grow and manage them from one platform. No setup fee or transaction fees. Free onboarding assistance.</p>
      <div class="page-hero__actions"><a class="btn pri" href="#plans">Compare plans &rarr;</a><a class="btn secbtn" href="/book-demo/">Discuss your setup</a><a class="btn shopify-app-badge" href="https://apps.shopify.com/punchout-central" target="_blank" rel="noopener noreferrer">Install on Shopify <span aria-hidden="true">↗</span></a></div>
    </div>
    
    <div class="hero-visual reveal">
      <div class="hero-visual__label"><span>Pricing</span><b>Simple</b></div>
      <div class="visual-flow"><div class="visual-step is-accent"><i>01</i><span><strong>Starter</strong><small>1 connection</small></span><em>$500/mo</em></div><div class="visual-step is-lavender"><i>02</i><span><strong>Growth</strong><small>Up to 4 connections</small></span><em>$1,000/mo</em></div><div class="visual-step is-peach"><i>03</i><span><strong>Scale</strong><small>Up to 7 connections</small></span><em>$1,500/mo</em></div><div class="visual-step is-lime"><i>04</i><span><strong>Additional connection</strong><small>Buyer or store</small></span><em>+$200/mo</em></div></div>
    </div>
  </div>
</section>


<section class="sec" id="plans"><div class="wrap"><div class="section-head reveal"><span class="ey">Plans</span><h2>Choose the connection allowance you need.</h2><p class="lead">Each plan includes the same Shopify PunchOut capabilities. A new buyer or additional store counts as a connection.</p></div>
<div class="pricing-grid">
<article class="price-card price-card--featured reveal"><span class="price-card__name">Starter</span><div class="price-card__price">$500 <small>/ month</small></div><p>For your first buyer connection.</p><ul><li>1 connection included</li><li>Shopify or Shopify Plus supplier catalog</li><li>Buyer-specific catalog access</li><li>cXML and OCI PunchOut support</li><li>PO, invoice and transaction visibility</li><li>Free onboarding assistance</li></ul><button class="btn secbtn pricing-modal-trigger" type="button" data-pricing-plan="Starter">Choose Starter</button></article>
<article class="price-card reveal"><span class="price-card__name">Growth</span><div class="price-card__price">$1,000 <small>/ month</small></div><p>For a store serving several enterprise buyers.</p><ul><li>Up to 4 connections included</li><li>All Starter capabilities</li><li>Manage buyer connections centrally</li><li>Buyer-specific store and collection access</li><li>Free onboarding assistance</li></ul><button class="btn secbtn pricing-modal-trigger" type="button" data-pricing-plan="Growth" data-modal-action="Start your">Start Growing</button></article>
<article class="price-card reveal"><span class="price-card__name">Scale</span><div class="price-card__price">$1,500 <small>/ month</small></div><p>For more buyers or stores on one platform.</p><ul><li>Up to 7 connections included</li><li>All Growth capabilities</li><li>Central store, buyer and transaction view</li><li>Free onboarding assistance</li></ul><button class="btn secbtn pricing-modal-trigger" type="button" data-pricing-plan="Scale" data-modal-action="Start your">Start Scale</button></article>
  </div>
  <section class="pricing-enterprise-tile reveal" aria-label="Enterprise pricing">
  <div>
    <span class="price-card__name">Enterprise</span>
    <h3>9+ connections or complex requirements</h3>
    <p>Talk with our team about multiple stores, advanced procurement workflows and a tailored rollout.</p>
  </div>
  <a class="btn secbtn" href="/book-demo/">Talk to sales &rarr;</a>
</section></div></section>

<div
  class="pricing-modal"
  id="pricingModal"
  aria-hidden="true"
  data-form-endpoint={formEndpoint}
  data-form-token={formToken}
  data-shopify-url={shopifyConnectUrl}
>
  <div class="pricing-modal__backdrop" data-pricing-close></div>
  <section class="pricing-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pricingModalTitle" tabindex="-1">
    <button class="pricing-modal__close" type="button" aria-label="Close" data-pricing-close>&times;</button>

    <div class="pricing-modal__content" data-pricing-content>
      <div class="pricing-modal__head">
        <span class="ey">Get started</span>
        <h2 id="pricingModalTitle"><span data-plan-action>Explore the</span> <span data-selected-plan>Starter</span> plan</h2>
        <p>Shopify and Shopify Plus are supported. Magento / Adobe Commerce and other platforms are coming soon&mdash;join the waitlist to tell us what you need.</p>
      </div>

      <div class="pricing-tabs" role="tablist" aria-label="Ecommerce platform">
        <button class="pricing-tab pricing-tab--shopify is-active" id="pricing-tab-shopify" type="button" role="tab" aria-selected="true" aria-controls="pricing-panel-shopify" data-platform="Shopify">
          <span class="pricing-tab__icon" aria-hidden="true" set:html={shopifyIcon}></span>
          <span>Shopify</span>
        </button>
        <button class="pricing-tab pricing-tab--magento" id="pricing-tab-magento" type="button" role="tab" aria-selected="false" aria-controls="pricing-panel-lead" data-platform="Magento / Adobe Commerce" tabindex="-1">
          <span class="pricing-tab__icon" aria-hidden="true" set:html={magentoIcon}></span>
          <span class="pricing-tab__label">Magento / Adobe Commerce<small>Coming soon</small></span>
        </button>
        <button class="pricing-tab pricing-tab--other" id="pricing-tab-other" type="button" role="tab" aria-selected="false" aria-controls="pricing-panel-lead" data-platform="Other" tabindex="-1">
          <span class="pricing-tab__icon" aria-hidden="true" set:html={otherIcon}></span>
          <span class="pricing-tab__label">Other platforms<small>Coming soon</small></span>
        </button>
      </div>

      <section class="pricing-platform-panel" id="pricing-panel-shopify" role="tabpanel" aria-labelledby="pricing-tab-shopify">
        <form id="shopifyConnectForm" novalidate>
          <div class="form-field">
            <label for="shopifyStore">Enter your Store URL</label>
            <input id="shopifyStore" name="store" type="text" placeholder="example.myshopify.com" inputmode="url" autocomplete="url" required>
          </div>
          <p class="pricing-form-error" id="shopifyError" role="alert"></p>
          <button class="btn pri pricing-modal__submit" type="submit">Continue with Shopify <span aria-hidden="true">&#8599;</span></button>
          <p class="pricing-modal__note">Continue to PunchOut Central registration for your Shopify store.</p>
        </form>
      </section>

      <section class="pricing-platform-panel" id="pricing-panel-lead" role="tabpanel" aria-labelledby="pricing-tab-magento" hidden>
        <form id="pricingLeadForm" action={formEndpoint} method="post" novalidate>
          <input type="hidden" name="form_source" value="pricing-interest">
          <input type="hidden" name="plan" value="Starter">
          <input type="hidden" name="platform" value="Magento / Adobe Commerce">
          <input type="hidden" name="page" value="">
          <input type="hidden" name="form_loaded_at" value="">
          <input class="book-demo-hp" type="text" name="nickname" tabindex="-1" autocomplete="off" aria-hidden="true">

          <p class="pricing-platform-panel__intro"><strong data-platform-name>Magento / Adobe Commerce</strong> is coming soon. Join the waitlist and tell us about your store.</p>
          <div class="form-grid">
            <div class="form-field">
              <label for="pricingName">Full Name</label>
              <input id="pricingName" name="name" type="text" autocomplete="name" required>
            </div>
            <div class="form-field">
              <label for="pricingEmail">Email</label>
              <input id="pricingEmail" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="form-field">
              <label for="pricingContact">Contact</label>
              <input id="pricingContact" name="contact" type="tel" autocomplete="tel" required>
            </div>
            <div class="form-field">
              <label for="pricingWebsite">Website <span>(Optional)</span></label>
              <input id="pricingWebsite" name="website" type="text" inputmode="url" autocomplete="url" placeholder="example.com">
            </div>
            <div class="form-field form-field--full" id="technologyField" hidden>
              <label for="pricingTechnology">Technology name <span>(Optional)</span></label>
              <input id="pricingTechnology" name="technology" type="text" placeholder="Tell us which ecommerce technology you use">
            </div>
          </div>
          <p class="pricing-form-error" id="pricingLeadError" role="alert"></p>
          <button class="btn pri pricing-modal__submit" id="pricingLeadSubmit" type="submit">Join waitlist</button>
        </form>
      </section>
    </div>

    <section class="pricing-modal__success" data-pricing-success aria-live="polite" hidden>
      <span class="pricing-modal__success-icon" aria-hidden="true">&#10003;</span>
      <span class="ey">Thank you</span>
      <h2>Next steps</h2>
      <p data-success-message>Thank you for your interest in PunchOut Central.</p>
      <p data-registration-followup hidden><a href="https://app.punchoutcentral.com" target="_blank" rel="noopener noreferrer">Continue Shopify registration &rarr;</a></p>
      <button class="btn pri" type="button" data-pricing-close>Done</button>
    </section>
  </section>
</div>

<section class="sec" id="connections">
  <div class="wrap">
    <div class="section-head reveal"><span class="ey">How connections are counted</span><h2>One store can serve several buyers.</h2><p class="lead">Keep your Shopify catalog in one store and add a connection for each enterprise buyer. An additional store also counts as a connection. Beyond a plan's included allowance, each additional connection is $200/month.</p></div>
    <div class="related-grid">
      <a class="related-card reveal" href="/solutions/one-store-multiple-buyers/"><span>One-store model</span><h3>Multiple buyers, one Shopify store</h3><p>See how buyer-specific catalog access and connections work.</p><b>Explore &rarr;</b></a>
      <a class="related-card reveal" href="/platform/transactions/"><span>Visibility</span><h3>Track each transaction</h3><p>Follow buyer sessions, carts, POs, store orders and invoices.</p><b>Explore &rarr;</b></a>
      <a class="related-card reveal" href="/book-demo/"><span>Plan your setup</span><h3>Talk through your buyer count</h3><p>Share the stores and procurement connections you need.</p><b>Request a demo &rarr;</b></a>
    </div>
  </div>
</section>
<section class="sec soft" id="details">
  <div class="wrap">
    <div class="section-head reveal"><span class="ey">Included with every plan</span><h2>Know what you pay for.</h2><p class="lead">The monthly price is based on connections, with no setup fee or transaction fee.</p></div>
    <div class="feature-grid"><article class="feature-card reveal"><span class="feature-card__icon">01</span><h3>No setup fee</h3><p>Get started without a setup charge.</p></article><article class="feature-card reveal"><span class="feature-card__icon">02</span><h3>No transaction fees</h3><p>Your software bill does not rise with order value.</p></article><article class="feature-card reveal"><span class="feature-card__icon">03</span><h3>Free onboarding assistance</h3><p>Get help connecting your store and first buyer.</p></article><article class="feature-card reveal"><span class="feature-card__icon">04</span><h3>No percentage of orders</h3><p>Keep the value of the business you win.</p></article><article class="feature-card reveal"><span class="feature-card__icon">05</span><h3>Pay as you grow</h3><p>Add connections for $200/month each.</p></article><article class="feature-card reveal"><span class="feature-card__icon">06</span><h3>Multiple connections</h3><p>A new buyer or additional store counts as a connection.</p></article></div>
  </div>
</section>
<section class="sec soft" id="faq">
  <div class="wrap">
    <div class="section-head center reveal"><span class="ey">FAQ</span><h2>Questions suppliers usually ask</h2></div>
    <div class="faq reveal"><div class="fi"><button class="fq" type="button"><span>Is there a setup fee?</span><span class="plus">+</span></button><div class="fa"><p>No. Onboarding assistance is free.</p></div></div><div class="fi"><button class="fq" type="button"><span>Do you charge transaction fees?</span><span class="plus">+</span></button><div class="fa"><p>No.</p></div></div><div class="fi"><button class="fq" type="button"><span>What counts as a connection?</span><span class="plus">+</span></button><div class="fa"><p>A new buyer or an additional store counts as a connection. Each additional connection beyond the plan allowance is $200/month.</p></div></div><div class="fi"><button class="fq" type="button"><span>Can buyers share one Shopify store?</span><span class="plus">+</span></button><div class="fa"><p>Yes. One store can serve multiple enterprise buyers, each with its own connection and catalog access settings.</p></div></div><div class="fi"><button class="fq" type="button"><span>How many connections are included?</span><span class="plus">+</span></button><div class="fa"><p>Starter includes 1 connection, Growth includes up to 4, and Scale includes up to 7.</p></div></div></div>
  </div>
</section>
<section class="page-cta">
  <div class="wrap reveal">
    <span class="ey">Choose a next step</span>
    <h2>Map your stores and buyers to a plan.</h2>
    <p class="lead">Compare your connection count, then review the setup with our team.</p>
    <div class="page-hero__actions">
      <a class="btn pri" href="/book-demo/">Talk to sales &rarr;</a>
      <a class="btn secbtn" href="/solutions/one-store-multiple-buyers/">One store, multiple buyers</a>
    </div>
  </div>
</section>
</main>

<script>
  const pricingModal = document.getElementById('pricingModal');

  if (pricingModal) {
    const dialog = pricingModal.querySelector('.pricing-modal__dialog');
    const modalContent = pricingModal.querySelector('[data-pricing-content]');
    const successState = pricingModal.querySelector('[data-pricing-success]');
    const successMessage = pricingModal.querySelector('[data-success-message]');
    const registrationFollowup = pricingModal.querySelector('[data-registration-followup]');
    const selectedPlanText = pricingModal.querySelector('[data-selected-plan]');
    const planActionText = pricingModal.querySelector('[data-plan-action]');
    const tabs = [...pricingModal.querySelectorAll('[role="tab"]')];
    const shopifyPanel = document.getElementById('pricing-panel-shopify');
    const leadPanel = document.getElementById('pricing-panel-lead');
    const shopifyForm = document.getElementById('shopifyConnectForm');
    const shopifyStore = document.getElementById('shopifyStore');
    const shopifyError = document.getElementById('shopifyError');
    const leadForm = document.getElementById('pricingLeadForm');
    const leadSubmit = document.getElementById('pricingLeadSubmit');
    const leadError = document.getElementById('pricingLeadError');
    const technologyField = document.getElementById('technologyField');
    const platformName = pricingModal.querySelector('[data-platform-name]');
    let selectedPlan = 'Starter';
    let selectedPlatform = 'Shopify';
    let returnFocus = null;

    const setError = (element, message = '') => {
      element.textContent = message;
      element.classList.toggle('is-visible', Boolean(message));
    };

    const showSuccess = message => {
      modalContent.hidden = true;
      successState.hidden = false;
      successMessage.textContent = message;
      successState.querySelector('button')?.focus();
    };

    const selectPlatform = (platform, focusTab = false) => {
      selectedPlatform = platform;
      tabs.forEach(tab => {
        const isActive = tab.dataset.platform === platform;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && focusTab) tab.focus();
      });

      const isShopify = platform === 'Shopify';
      shopifyPanel.hidden = !isShopify;
      leadPanel.hidden = isShopify;
      technologyField.hidden = platform !== 'Other';
      if (!isShopify) {
        leadPanel.setAttribute('aria-labelledby', tabs.find(tab => tab.dataset.platform === platform)?.id || 'pricing-tab-other');
        leadForm.elements.platform.value = platform;
        platformName.textContent = platform;
      }
      setError(shopifyError);
      setError(leadError);
    };

    const openModal = trigger => {
      selectedPlan = trigger.dataset.pricingPlan || 'Starter';
      returnFocus = trigger;
      planActionText.textContent = trigger.dataset.modalAction || 'Explore the';
      selectedPlanText.textContent = selectedPlan;
      leadForm.elements.plan.value = selectedPlan;
      leadForm.elements.page.value = window.location.href;
      leadForm.elements.form_loaded_at.value = String(Date.now());
      modalContent.hidden = false;
      successState.hidden = true;
      registrationFollowup.hidden = true;
      selectPlatform('Shopify');
      pricingModal.classList.add('is-open');
      pricingModal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('pricing-modal-open');
      window.setTimeout(() => dialog.focus(), 30);
    };

    const closeModal = () => {
      pricingModal.classList.remove('is-open');
      pricingModal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('pricing-modal-open');
      setError(shopifyError);
      setError(leadError);
      returnFocus?.focus();
    };

    document.querySelectorAll('.pricing-modal-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => openModal(trigger));
    });

    pricingModal.querySelectorAll('[data-pricing-close]').forEach(button => {
      button.addEventListener('click', closeModal);
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectPlatform(tab.dataset.platform));
      tab.addEventListener('keydown', event => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        selectPlatform(tabs[nextIndex].dataset.platform, true);
      });
    });

    shopifyForm.addEventListener('submit', event => {
      event.preventDefault();
      const rawStore = shopifyStore.value.trim().toLowerCase();
      const normalizedStore = rawStore.replace(/^https?:\/\//, '').replace(/\/$/, '').split('/')[0];

      if (!/^[a-z0-9][a-z0-9-]*\.myshopify\.com$/.test(normalizedStore)) {
        setError(shopifyError, 'Please enter a valid Shopify store URL, such as example.myshopify.com.');
        shopifyStore.focus();
        return;
      }

      setError(shopifyError);
      const destination = new URL(pricingModal.dataset.shopifyUrl, window.location.origin);
      destination.searchParams.set('shop', normalizedStore);
      registrationFollowup.querySelector('a').href = destination.toString();
      registrationFollowup.hidden = false;
      window.open(destination.toString(), '_blank', 'noopener,noreferrer');
      showSuccess(`Use the registration tab for ${normalizedStore} if it opened, or continue with the link below.`);
    });

    leadForm.addEventListener('submit', async event => {
      event.preventDefault();
      setError(leadError);

      if (!leadForm.checkValidity()) {
        leadForm.reportValidity();
        return;
      }

      leadSubmit.disabled = true;
      leadSubmit.textContent = 'Sending...';

      try {
        const payload = Object.fromEntries(new FormData(leadForm).entries());
        payload.referrer = document.referrer;
        const headers = { 'Content-Type': 'application/json' };
        if (pricingModal.dataset.formToken) headers['X-Book-Demo-Token'] = pricingModal.dataset.formToken;
        const response = await fetch(pricingModal.dataset.formEndpoint, {
          method: 'POST',
          headers,
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.message || 'We could not send your request right now.');

        if (!result.email?.sent && !result.recorded && !result.submission_id) {
          throw new Error('The request was not confirmed. Please try again.');
        }
        leadForm.reset();
        showSuccess(result.email?.sent
          ? `You joined the ${selectedPlatform} waitlist. We will follow up.`
          : `Your ${selectedPlatform} waitlist request was recorded. We will follow up.`);
      } catch (error) {
        setError(leadError, error instanceof Error ? error.message : 'We could not send your request right now.');
      } finally {
        leadSubmit.disabled = false;
        leadSubmit.textContent = 'Join waitlist';
      }
    });

    document.addEventListener('keydown', event => {
      if (!pricingModal.classList.contains('is-open')) return;
      if (event.key === 'Escape') closeModal();
      if (event.key !== 'Tab') return;

      const focusable = [...dialog.querySelectorAll('button:not([disabled]):not([hidden]), input:not([disabled]):not([type="hidden"]), [href]')]
        .filter(element => element.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
