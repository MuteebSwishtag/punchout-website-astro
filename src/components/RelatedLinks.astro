---
import { relatedPublishedLinks } from '../lib/internal-links.mjs';

interface Props {
  source: string;
  heading?: string;
}

const { source, heading = 'Continue exploring' } = Astro.props;
const links = relatedPublishedLinks(source);
---
{links.length > 0 && <section class="sec soft" aria-label="Related PunchOut pages">
  <div class="wrap">
    <div class="section-head reveal"><span class="ey">Related topics</span><h2>{heading}</h2></div>
    <div class="related-grid">
      {links.map((link) => <a class="related-card reveal" href={link.path}><h3>{link.title}</h3><p>{link.description}</p><b>Explore →</b></a>)}
    </div>
  </div>
</section>}
