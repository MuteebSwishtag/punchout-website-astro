---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favicons from '../components/Favicons.astro';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerNoScript from '../components/GoogleTagManagerNoScript.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  includeSiteScript?: boolean;
}

const {
  title,
  description = '',
  bodyClass = 'inner-page',
  includeSiteScript = true
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManagerHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {description && <meta name="description" content={description}>}
    <meta name="theme-color" content="#99FEEC">
    <Favicons />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.brandfetch.io" crossorigin>
    <link rel="dns-prefetch" href="//cdn.brandfetch.io">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class={bodyClass || undefined}>
    <GoogleTagManagerNoScript />
    <Header />
    <slot />
    <Footer />
    {includeSiteScript && <script src="/assets/site.js" defer></script>}
  </body>
</html>
