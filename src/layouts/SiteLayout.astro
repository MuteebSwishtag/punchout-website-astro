---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favicons from '../components/Favicons.astro';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerNoScript from '../components/GoogleTagManagerNoScript.astro';
import jakartaSansLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  includeSiteScript?: boolean;
  deferredStylesheets?: string[];
}

const {
  title,
  description = '',
  bodyClass = 'inner-page',
  includeSiteScript = true,
  deferredStylesheets = []
} = Astro.props;

const siteScriptSrc = '/assets/site.js?v=20261002';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <GoogleTagManagerHead />
    {description && <meta name="description" content={description}>}
    <meta name="theme-color" content="#99FEEC">
    <Favicons />
    <title>{title}</title>
    <link rel="preload" as="font" type="font/woff2" href={jakartaSansLatin} crossorigin>
    {deferredStylesheets.map((href) => (
      <>
        <link rel="preload" as="style" href={href}>
        <link rel="stylesheet" href={href} media="print" onload="this.media='all'">
        <noscript><link rel="stylesheet" href={href}></noscript>
      </>
    ))}
  </head>
  <body class={bodyClass || undefined}>
    <GoogleTagManagerNoScript />
    <Header />
    <slot />
    <Footer />
    {includeSiteScript && <script src={siteScriptSrc} defer></script>}
  </body>
</html>
