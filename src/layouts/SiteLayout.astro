---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favicons from '../components/Favicons.astro';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import LinkedInInsightHead from '../components/LinkedInInsightHead.astro';
import LinkedInInsightNoScript from '../components/LinkedInInsightNoScript.astro';
import MetaPixelHead from '../components/MetaPixelHead.astro';
import MetaPixelNoScript from '../components/MetaPixelNoScript.astro';
import PinterestTagHead from '../components/PinterestTagHead.astro';
import PinterestTagNoScript from '../components/PinterestTagNoScript.astro';
import XConversionTrackingHead from '../components/XConversionTrackingHead.astro';
import SeoMeta from '../components/SeoMeta.astro';
import { getRoute, pageRobots } from '../lib/site-registry.mjs';
import { canonicalUrl } from '../lib/site-config.mjs';
import jakartaSansLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/site-critical.css';
import siteStylesheet from '../styles/site.css?url';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  structuredData?: Record<string, unknown>[];
  bodyClass?: string;
  includeSiteScript?: boolean;
  tracking?: 'all' | 'ga4' | 'none';
  showFooterDecoration?: boolean;
  deferSiteStylesheet?: boolean;
  eagerStylesheets?: string[];
  deferredStylesheets?: string[];
}

const {
  title,
  description = '',
  robots = '',
  canonicalPath,
  ogType,
  ogImage,
  twitterCard,
  structuredData,
  bodyClass = 'inner-page',
  includeSiteScript = true,
  tracking = 'all',
  showFooterDecoration = true,
  deferSiteStylesheet = false,
  eagerStylesheets = [],
  deferredStylesheets = []
} = Astro.props;

const pathname = Astro.url.pathname;
const isHomepage = pathname === '/';
const requiredRobots = pageRobots(pathname);
const resolvedRobots = requiredRobots || robots;
const showSeoMeta = getRoute(pathname)?.publicationEligible && !/\bnoindex\b/i.test(resolvedRobots);
const resolvedOgImage = ogImage ?? '/assets/punchout-central-share.png';

const siteScriptSrc = '/assets/site.js?v=20261015';
const eagerStylesheetSet = new Set([
  ...(deferSiteStylesheet ? [] : [siteStylesheet]),
  ...eagerStylesheets
]);
const renderEagerStylesheets = [...eagerStylesheetSet];
const lazyStylesheets = [
  ...(deferSiteStylesheet ? [siteStylesheet] : []),
  ...deferredStylesheets
].filter((href) => !eagerStylesheetSet.has(href));
const noscriptStylesheets = [...renderEagerStylesheets, ...lazyStylesheets];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script is:inline>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
    {(tracking === 'all' || tracking === 'ga4') && <GoogleTagManagerHead />}
    {tracking === 'all' && <MetaPixelHead />}
    {tracking === 'all' && <LinkedInInsightHead />}
    {tracking === 'all' && <PinterestTagHead />}
    {tracking === 'all' && <XConversionTrackingHead />}
    {description && <meta name="description" content={description}>}
    {resolvedRobots && <meta name="robots" content={resolvedRobots}>}
    <meta name="theme-color" content="#99FEEC">
    <Favicons />
    <title>{title}</title>
    {showSeoMeta && <SeoMeta pathname={pathname} title={title} description={description} canonicalPath={canonicalPath} ogType={ogType} ogImage={resolvedOgImage} twitterCard={twitterCard} structuredData={structuredData} />}
    <link rel="preload" as="font" type="font/woff2" href={jakartaSansLatin} crossorigin>
    {renderEagerStylesheets.map((href) => <link rel="stylesheet" href={href}> )}
    <noscript>
      {noscriptStylesheets.map((href) => <link rel="stylesheet" href={href}> )}
    </noscript>
  </head>
  <body class={bodyClass || undefined}>
    {tracking === 'all' && <MetaPixelNoScript />}
    {tracking === 'all' && <LinkedInInsightNoScript />}
    {tracking === 'all' && <PinterestTagNoScript />}
    <Header />
    <slot />
    <Footer showDecoration={showFooterDecoration} />
    {lazyStylesheets.length > 0 && (
      <script is:inline define:vars={{ lazyStylesheets }}>
        (() => {
          const loaded = new Set();
          const loadStylesheet = (href) => {
            if (!href || loaded.has(href) || document.querySelector(`link[rel="stylesheet"][href="${href}"]`)) return;
            loaded.add(href);
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            document.head.appendChild(link);
          };

          const loadAll = () => lazyStylesheets.forEach(loadStylesheet);
          const schedule = () => {
            window.removeEventListener('pointerdown', schedule);
            window.removeEventListener('keydown', schedule);
            window.removeEventListener('scroll', schedule);
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadAll, { timeout: 2600 });
            } else {
              window.setTimeout(loadAll, 900);
            }
          };

          window.addEventListener('load', () => window.setTimeout(loadAll, 9000), { once: true });
          window.addEventListener('pointerdown', schedule, { once: true, passive: true });
          window.addEventListener('keydown', schedule, { once: true });
          window.addEventListener('scroll', schedule, { once: true, passive: true });
        })();
      </script>
    )}
    {includeSiteScript && <script src={siteScriptSrc} defer></script>}
  </body>
</html>
