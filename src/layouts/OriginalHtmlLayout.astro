---
interface Props {
  headHtml: string;
  bodyHtml: string;
  bodyClass?: string;
}

const { headHtml, bodyHtml, bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body class={bodyClass || undefined}>
    <Fragment set:html={bodyHtml} />
  </body>
</html>
