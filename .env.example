# Book Demo frontend
PUBLIC_BOOK_DEMO_ENDPOINT=/api/book-demo.php
# Optional lightweight endpoint match token. This value is exposed to the browser.
PUBLIC_BOOK_DEMO_TOKEN=

# Book Demo endpoint
# Optional. On Hostinger, prefer a private PHP config file outside public_html.
BOOK_DEMO_CONFIG_PATH=/home/YOUR_ACCOUNT/punchout-book-demo-config.php
BOOK_DEMO_ENDPOINT_TOKEN=

# Email delivery
BOOK_DEMO_EMAIL_ENABLED=false
BOOK_DEMO_TO=hello@punchoutcentral.com
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@punchoutcentral.com
MAIL_FROM_NAME=PunchOut Central

# Zoom Server-to-Server OAuth
BOOK_DEMO_ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
ZOOM_MEETING_DURATION_MINUTES=30
ZOOM_REGISTRATION_ENABLED=true
ZOOM_INVITEE_EMAILS=hello@punchoutcentral.com
ZOOM_CONTACT_NAME=PunchOut Central
ZOOM_CONTACT_EMAIL=hello@punchoutcentral.com
ZOOM_MEETING_TOPIC_TEMPLATE=PunchOut Central demo with ${company}
ZOOM_MEETING_AGENDA_TEMPLATE=Demo requested by ${name} from ${company}. Buyer platform: ${platform}.
