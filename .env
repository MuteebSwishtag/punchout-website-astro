# Book Demo frontend
PUBLIC_BOOK_DEMO_ENDPOINT=/api/book-demo.php
# Optional lightweight endpoint match token. This value is exposed to the browser.
PUBLIC_BOOK_DEMO_TOKEN=

# Pricing modal (reuses the Book Demo mail endpoint and SMTP settings)
PUBLIC_PRICING_FORM_ENDPOINT=/api/book-demo.php
# If BOOK_DEMO_ENDPOINT_TOKEN is enabled, set this to the same value.
PUBLIC_PRICING_FORM_TOKEN=
PUBLIC_SHOPIFY_CONNECT_URL=https://app.punchoutcentral.com/platform/register

# Admin dashboard
PUBLIC_ADMIN_SUBMISSIONS_ENDPOINT=/api/admin-submissions.php
BOOK_DEMO_ADMIN_USERNAME=admin
BOOK_DEMO_ADMIN_PASSWORD=admin

# Book Demo endpoint
# Optional. On Hostinger, prefer a private PHP config or env file outside public_html.
BOOK_DEMO_ENV_PATH=/home/u464662635/punchout-book-demo.env
BOOK_DEMO_CONFIG_PATH=/home/u464662635/punchout-book-demo-config.php
BOOK_DEMO_ENDPOINT_TOKEN=

# MySQL storage
# The PHP endpoint creates BOOK_DEMO_DB_TABLE if it does not already exist.
BOOK_DEMO_DB_ENABLED=true
BOOK_DEMO_DB_TABLE=book_demo_submissions
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=u464662635_PunchoutDB
DB_USERNAME=u464662635_root
DB_PASSWORD=PromoPlus@swishtag1
DB_CHARSET=utf8mb4

# Email delivery
BOOK_DEMO_EMAIL_ENABLED=false
BOOK_DEMO_TO=hello@punchoutcentral.com
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@punchoutcentral.com
MAIL_FROM_NAME=PunchOut Central

# Zoom Server-to-Server OAuth
BOOK_DEMO_ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
ZOOM_MEETING_DURATION_MINUTES=30
ZOOM_REGISTRATION_ENABLED=true
ZOOM_INVITEE_EMAILS=hello@punchoutcentral.com
ZOOM_CONTACT_NAME=PunchOut Central
ZOOM_CONTACT_EMAIL=hello@punchoutcentral.com
ZOOM_MEETING_TOPIC_TEMPLATE=PunchOut Central demo with ${company}
ZOOM_MEETING_AGENDA_TEMPLATE=Demo requested by ${name} from ${company}. Buyer platform: ${platform}.
