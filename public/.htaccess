<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8

# Reviewed legacy content routes. Route files remain in the static build.
# Anchors and optional source slashes avoid matching assets or API requests.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/product/punchout/?$ /platform/punchout/
  RedirectMatch 301 ^/product/invoice-automation/?$ /platform/invoices/
  RedirectMatch 301 ^/product/multi-store-management/?$ /platform/multi-store/
  RedirectMatch 301 ^/product/purchase-order-automation/?$ /platform/purchase-orders/
  RedirectMatch 301 ^/product/reporting-monitoring/?$ /platform/transactions/
  RedirectMatch 301 ^/resources/what-is-punchout/?$ /resources/punchout-guide/
  RedirectMatch 301 ^/industries/promotional-print-uniforms/?$ /industries/promotional-products/
  RedirectMatch 301 ^/about/?$ /company/
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Type "text/html; charset=UTF-8" "expr=%{CONTENT_TYPE} =~ m#^text/html#"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://stats.g.doubleclick.net; frame-src https://www.googletagmanager.com; form-action 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(?:avif|webp|png|jpe?g|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
