<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8

# Canonicalize the host while preserving the requested path and query string.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.punchoutcentral\.com$ [NC]
  RewriteRule ^ https://punchoutcentral.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Serve the site's custom 404 page for every unmatched request while keeping
# the response status as 404.
ErrorDocument 404 /404.html

# Reviewed legacy content routes. Route files remain in the static build.
# Anchors and optional source slashes avoid matching assets or API requests.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/product/punchout/?$ /platform/punchout/
  RedirectMatch 301 ^/product/invoice-automation/?$ /platform/invoices/
  RedirectMatch 301 ^/product/multi-store-management/?$ /platform/multi-store/
  RedirectMatch 301 ^/product/purchase-order-automation/?$ /platform/purchase-orders/
  RedirectMatch 301 ^/product/reporting-monitoring/?$ /platform/transactions/
  RedirectMatch 301 ^/resources/what-is-punchout/?$ /resources/punchout-guide/
  RedirectMatch 301 ^/industries/promotional-print-uniforms/?$ /industries/promotional-products/
  RedirectMatch 301 ^/about/?$ /company/
  RedirectMatch 301 ^/privacy/?$ https://app.punchoutcentral.com/privacy
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Type "text/html; charset=UTF-8" "expr=%{CONTENT_TYPE} =~ m#^text/html#"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com https://px.ads.linkedin.com https://ct.pinterest.com https://analytics.twitter.com https://t.co; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://snap.licdn.com https://s.pinimg.com https://static.ads-twitter.com https://ct.pinterest.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://www.facebook.com https://px.ads.linkedin.com https://ct.pinterest.com https://s.pinimg.com https://analytics.twitter.com; frame-src https://www.googletagmanager.com https://ct.pinterest.com; form-action 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(?:avif|webp|png|jpe?g|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
